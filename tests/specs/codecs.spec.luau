describe("MeshData", function()
	local MeshData

	beforeEach(function()
		MeshData = requireShared("MeshData")
	end)

	it("lists the vehicles with embedded data", function()
		expect(MeshData.list()).toEqual({ "Bicycle", "Scooter", "Van" })
		expect(MeshData.has("Bicycle")).toBe(true)
		expect(MeshData.has("Van")).toBe(true)
		expect(MeshData.has("Truck")).toBe(false)
		expect(MeshData.has("MeshPack")).toBe(false)
		expect(MeshData.has("report")).toBe(false)
		expect(MeshData.has(nil)).toBe(false)
		expect(MeshData.has(42)).toBe(false)
	end)

	it("returns the generated index tables", function()
		local E = vectors().embedded
		for _, id in ipairs(MeshData.list()) do
			local index = MeshData.index(id)
			expect(index.vehicleId).toBe(id)
			expect(index.version).toBe(1)
			expect(index.geometry.chunks).toBe(E[id].geometryChunks)
			expect(index.geometry.bytes).toBe(E[id].geometryBytes)
			expect(index.geometry.vertexCount).toBe(E[id].vertexCount)
			expect(index.geometry.triangleCount).toBe(E[id].triangleCount)
			expect(index.texture.chunks).toBe(E[id].textureChunks)
			expect(index.texture.bytes).toBe(E[id].textureBytes)
			expect(index.texture.width).toBe(E[id].width)
			expect(index.texture.height).toBe(E[id].height)
			expect(index.texture.format).toBe("png")
		end
		expect(function()
			MeshData.index("Truck")
		end).toThrow("no embedded data")
		expect(function()
			MeshData.loadGeometry("Truck")
		end).toThrow("no embedded data")
	end)

	it("loadTexture / loadGeometry decode chunk by chunk and report progress per chunk", function()
		local Inflate = requireShared("Util/Inflate")
		for _, id in ipairs(MeshData.list()) do
			local index = MeshData.index(id)
			for _, pair in ipairs({ { "loadTexture", index.texture }, { "loadGeometry", index.geometry } }) do
				local method, part = pair[1], pair[2]
				local calls = {}
				local chunked = MeshData[method](id, {
					onProgress = function(done, total)
						table.insert(calls, { done, total })
					end,
				})
				-- one call per chunk, strictly increasing, ending at the declared byte count
				expect(#calls).toBe(part.chunks)
				local last = 0
				for _, call in ipairs(calls) do
					expect(call[1]).toBeGreaterThan(last)
					expect(call[2]).toBe(part.bytes)
					last = call[1]
				end
				expect(last).toBe(part.bytes)
				expect(buffer.len(chunked)).toBe(part.bytes)
				-- byte-identical to the plain (single-string) decode
				local plain = MeshData[method](id)
				expect(Inflate.adler32(chunked)).toBe(Inflate.adler32(plain))
				expect(buffer.tostring(chunked) == buffer.tostring(plain)).toBe(true)
			end
		end
	end)
end)


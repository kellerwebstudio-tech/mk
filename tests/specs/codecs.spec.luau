describe("Embedded vehicle data end-to-end", function()
	local Inflate, PngDecoder, MeshPack, MeshData, E

	beforeEach(function()
		Inflate = requireShared("Util/Inflate")
		PngDecoder = requireShared("Util/PngDecoder")
		MeshPack = requireShared("MeshData/MeshPack")
		MeshData = requireShared("MeshData")
		E = vectors().embedded
	end)

	for _, id in ipairs({ "Bicycle", "Scooter", "Van" }) do
		it("decodes the embedded " .. id .. " texture (1024x1024, Adler-32 verified) and geometry", function()
			local expected = E[id]
			local index = MeshData.index(id)

			-- texture: base64 chunks -> PNG bytes -> RGBA
			local t0 = realClock()
			local png = MeshData.loadTexture(id)
			local tTexture = realClock() - t0
			expect(buffer.len(png)).toBe(expected.textureBytes)
			expect(Inflate.adler32(png)).toBe(expected.textureAdler)

			local progressCalls = 0
			local adlerSliceCalls = 0 -- fraction exactly 0.5: inflate finished, Adler-32 slices in progress
			local expandCalls = 0 -- fraction in (0.9, 1): RGBA expansion rows
			local lastFraction = -1
			t0 = realClock()
			local image = PngDecoder.decode(png, {
				onProgress = function(fraction)
					progressCalls += 1
					expect(fraction).toBeGreaterThanOrEqual(lastFraction)
					lastFraction = fraction
					if fraction == 0.5 then
						adlerSliceCalls += 1
					elseif fraction > 0.9 and fraction < 1 then
						expandCalls += 1
					end
				end,
			})
			local tDecode = realClock() - t0
			expect(image.width).toBe(1024)
			expect(image.height).toBe(1024)
			expect(image.width).toBe(index.texture.width)
			expect(image.height).toBe(index.texture.height)
			expect(buffer.len(image.rgba)).toBe(1024 * 1024 * 4)
			-- the zlib trailer check passed and matched the checksum Python computed for the stream
			expect(image.adler32).toBe(expected.idatAdler)
			-- and the pixels are exactly what PIL decodes
			expect(Inflate.adler32(image.rgba)).toBe(expected.rgbaAdler)
			expect(progressCalls).toBeGreaterThanOrEqual(10)
			expect(lastFraction).toBe(1)
			-- a 3 MB raw stream is checksummed in 256 KB slices (11 calls between 12 slices + the
			-- final inflate call) and expanded to RGBA with a call every ~64 KB of output rows
			expect(adlerSliceCalls).toBeGreaterThanOrEqual(10)
			expect(expandCalls).toBeGreaterThanOrEqual(20)

			-- geometry: base64 chunks -> DDCM -> vectors
			t0 = realClock()
			local blob = MeshData.loadGeometry(id)
			local tGeometry = realClock() - t0
			expect(buffer.len(blob)).toBe(expected.geometryBytes)
			expect(Inflate.adler32(blob)).toBe(expected.geometryAdler)
			t0 = realClock()
			local mesh = MeshPack.decode(blob)
			local tMesh = realClock() - t0
			expect(mesh.vertexCount).toBe(index.geometry.vertexCount)
			expect(mesh.triangleCount).toBe(index.geometry.triangleCount)
			expect(mesh.vertexCount).toBe(expected.vertexCount)
			expect(mesh.triangleCount).toBe(expected.triangleCount)
			expect(#mesh.positions).toBe(mesh.vertexCount)
			expect(#mesh.normals).toBe(mesh.vertexCount)
			expect(#mesh.uvs).toBe(mesh.vertexCount)
			expect(#mesh.triangles).toBe(mesh.triangleCount * 3)
			local bmin, bmax = index.geometry.bboxMin, index.geometry.bboxMax
			expect(mesh.bboxMin).toBeCloseTo(Vector3.new(bmin[1], bmin[2], bmin[3]), 1e-3)
			expect(mesh.bboxMax).toBeCloseTo(Vector3.new(bmax[1], bmax[2], bmax[3]), 1e-3)
			local actualMin, actualMax = mesh.positions[1], mesh.positions[1]
			for i = 1, mesh.vertexCount do
				local p = mesh.positions[i]
				actualMin = actualMin:Min(p)
				actualMax = actualMax:Max(p)
				local uv = mesh.uvs[i]
				if uv.X < 0 or uv.X > 1 or uv.Y < 0 or uv.Y > 1 then
					error(string.format("%s: uv %d out of range (%s)", id, i, tostring(uv)))
				end
				local len = mesh.normals[i].Magnitude
				if math.abs(len - 1) > 0.02 then
					error(string.format("%s: normal %d has length %.4f", id, i, len))
				end
			end
			expect(actualMin).toBeCloseTo(mesh.bboxMin, 1e-4)
			expect(actualMax).toBeCloseTo(mesh.bboxMax, 1e-4)
			for i = 1, #mesh.triangles do
				local v = mesh.triangles[i]
				if v < 1 or v > mesh.vertexCount or v % 1 ~= 0 then
					error(string.format("%s: triangle index %d is %s", id, i, tostring(v)))
				end
			end

			print(string.format(
				"[codecs] %s: texture base64 %.0f ms, PNG decode %.0f ms (%dx%d); geometry base64 %.0f ms, DDCM decode %.0f ms (%d verts, %d tris)",
				id,
				tTexture * 1000,
				tDecode * 1000,
				image.width,
				image.height,
				tGeometry * 1000,
				tMesh * 1000,
				mesh.vertexCount,
				mesh.triangleCount
			))
		end)
	end
end)

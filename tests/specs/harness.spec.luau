describe("module loading", function()
	it("require resolves a bundled module with script injected", function()
		local mod = shim.requirePath("ReplicatedStorage/TestFixtures/FixtureModule")
		expect(mod.scriptName).toBe("FixtureModule")
		expect(mod.parentName).toBe("TestFixtures")
		expect(mod.fullName).toBe("ReplicatedStorage.TestFixtures.FixtureModule")
		expect(mod.fixturesFolder).toBe(game:GetService("ReplicatedStorage").TestFixtures)
		expect(mod.helperValue).toBe(42)
		expect(mod.double(4)).toBe(8)
		expect(mod.loadCount).toBe(1)
		-- cached by instance identity
		local inst = shim.getInstance("ReplicatedStorage.TestFixtures.FixtureModule")
		expect(inst).toBeA("ModuleScript")
		expect(require(inst)).toBe(mod)
		expect(shim.requirePath("ReplicatedStorage/TestFixtures/FixtureModule")).toBe(mod)
		expect(_G.fixtureLoadCount).toBe(1) -- specs share the modules' _G (shim.G)
		expect(_G).toBe(shim.G)
		expect(shim.listModules()).toContain("ReplicatedStorage/TestFixtures/FixtureHelper")
		-- JSON files become modules returning tables
		local sample = shim.requirePath("ReplicatedStorage/TestFixtures/sample")
		expect(sample.name).toBe("sample")
		expect(sample.values).toEqual({ 1, 2, 3 })
		expect(sample.nested.ok).toBe(true)
	end)

	it("modules are re-executed after shim.reset (isolation)", function()
		local mod = shim.requirePath("ReplicatedStorage/TestFixtures/FixtureModule")
		expect(mod.loadCount).toBe(1)
	end)

	it("detects require cycles with a clear message", function()
		expect(function() shim.requirePath("ReplicatedStorage/TestFixtures/CycleA") end).toThrow("required recursively")
		expect(function() shim.requirePath("ReplicatedStorage/TestFixtures/CycleA") end).toThrow("CycleA")
	end)

	it("compiles lazily: a broken module only fails when required, naming its path", function()
		expect(function() shim.requirePath("ReplicatedStorage/TestFixtures/BrokenModule") end).toThrow("BrokenModule failed to compile")
		expect(function() shim.requirePath("ReplicatedStorage/TestFixtures/ErroringModule") end).toThrow("ReplicatedStorage/TestFixtures/ErroringModule experienced an error while loading: tests/fixtures/ErroringModule.luau:3: fixture exploded on purpose")
		expect(function() shim.requirePath("ReplicatedStorage/TestFixtures/Missing") end).toThrow("No instance at path")
		expect(function() require(game:GetService("ReplicatedStorage").TestFixtures) end).toThrow("not a ModuleScript")
		expect(function() require("string path") end).toThrow("not supported")
		expect(function() require(12345) end).toThrow("asset id")
	end)

	it("scripts are not auto-run; shim.runScript runs one explicitly and may yield", function()
		expect(workspace:GetAttribute("FixtureScriptRan")).toBeNil()
		local script = shim.getInstance("ReplicatedStorage/TestFixtures/FixtureScript")
		expect(script.ClassName).toBe("Script")
		local th = shim.runScript(script)
		expect(workspace:GetAttribute("FixtureScriptRan")).toBe(true)
		expect(workspace:GetAttribute("FixtureScriptClass")).toBe("Script")
		expect(workspace:GetAttribute("FixtureScriptFinished")).toBeNil()
		shim.advance(1)
		expect(coroutine.status(th)).toBe("dead")
		expect(workspace:GetAttribute("FixtureScriptFinished")).toBeCloseTo(1001)
	end)
end)

--!nonstrict
-- EmbeddedMeshController: rebuilds the meshes embedded in the place (ReplicatedStorage.Shared.
-- MeshData.<EntryId>, generated by tools/mesh_embed.py: vehicles, people figures, the courier
-- vest) with EditableMesh / EditableImage and attaches the result to every placeholder Part tagged
-- "EmbeddedMeshBody" (attributes EmbeddedMesh = entry id, EmbeddedPart = part name, default
-- "Body", optional MeshColor for untextured entries; built by VehicleBuilder, Shared.Util.FigureRig
-- and ShopService).
--
-- Start(): one background task decodes the MeshData entries one after another (PRIORITY first,
-- then the rest of MeshData.list()); per entry
--   1. index(id); when the entry has a texture: loadTexture → PngDecoder.decode → EditableImage
--      (WritePixelsBuffer of the RGBA8 buffer), one per entry,
--   2. per index part: loadPart → MeshPack.decode → EditableMesh (AddVertex/AddNormal/AddUV per
--      vertex, AddTriangle + SetFaceNormals/SetFaceUVs per face) →
--      AssetService:CreateMeshPartAsync(Content.fromObject(editableMesh)) → one cosmetic MeshPart
--      "EmbeddedMesh" (TextureContent = the entry's EditableImage when textured; Size = the vehicle
--      definition's mesh.body.size for vehicles, else the part's bounding box) cached under
--      (entryId, partName). Every loader/decoder gets an onProgress callback that task.wait()s after
--      at most YIELD_BUDGET seconds of work. When every part is built, Loaded fires with the id.
-- Every step is pcall-wrapped: a failure warns once ("[EmbeddedMeshController] <id>: ...") and the
-- entry's placeholders (present or later) become FAILED_TRANSPARENCY grey boxes (tinted with
-- MeshColor when set) so nothing is ever invisible.
--
-- Attachment: CollectionService:GetTagged(TAG) + GetInstanceAddedSignal(TAG). A placeholder whose
-- part is ready and that has no child "EmbeddedMesh" gets a clone of the cached MeshPart:
-- CFrame = placeholder.CFrame, parented under the placeholder, welded with a WeldConstraint
-- "MeshWeld" (Part0 = placeholder, Part1 = clone) or anchored when the placeholder is Anchored.
-- Untextured entries take the placeholder's MeshColor attribute as the clone's Color (Material
-- SmoothPlastic) and follow GetAttributeChangedSignal("MeshColor"). A placeholder that streams out
-- takes its child with it and is dressed again when it streams back in.
--
-- Test hook: EmbeddedMeshController._setDecoders({ list, index, loadPart, loadTexture, decodePng,
-- decodeMesh }) replaces the Shared modules (nil restores them). DecodeStats[id] records the
-- seconds spent per phase and the number of parts.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local AssetService = game:GetService("AssetService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Definitions = Shared:WaitForChild("Definitions")
local Util = Shared:WaitForChild("Util")
local VehicleDefinitions = require(Definitions:WaitForChild("VehicleDefinitions"))
local Signal = require(Util:WaitForChild("Signal"))

local EmbeddedMeshController = {}

EmbeddedMeshController.TAG = "EmbeddedMeshBody"
EmbeddedMeshController.MESH_NAME = "EmbeddedMesh"
EmbeddedMeshController.PLACEHOLDER_NAME = "MeshBody"
EmbeddedMeshController.DEFAULT_PART = "Body"
EmbeddedMeshController.FAILED_TRANSPARENCY = 0.4
-- Seconds of decode work between task.wait() calls (keeps the frame rate smooth after join).
EmbeddedMeshController.YIELD_BUDGET = 0.025
-- Vertices / faces fed to the EditableMesh between yield checks.
EmbeddedMeshController.BATCH = 256
-- Decode order: the player's own vest and bicycle first, then the people nearest the spawn, then
-- the rest; ids missing from MeshData.list() are skipped, other ids follow in list order.
EmbeddedMeshController.PRIORITY = {
	"CourierVest", "Bicycle", "NPCStaff", "NPCCustomerA", "NPCCustomerB",
	"NPCPedestrianA", "NPCPedestrianB", "NPCPedestrianC", "NPCWorker", "NPCDriver", "Scooter", "Van",
}

EmbeddedMeshController.Loaded = Signal.new()
EmbeddedMeshController.DecodeStats = {}

local ctx = nil
local started = false
local cache: { [string]: { [string]: MeshPart } } = {}
local ready: { [string]: boolean } = {}
local textured: { [string]: boolean } = {}
local holders: { [string]: { meshes: { any }, image: any } } = {}
local failed: { [string]: boolean } = {}
local loading: { [string]: boolean } = {}
local decoderOverride: any = nil
local decoders: any = nil
local tagConnection = nil
local colorWatched = setmetatable({}, { __mode = "k" })

-------------------------------------------------------------------------------
-- Decoders (Shared modules, resolved lazily so a missing module only disables the feature)
-------------------------------------------------------------------------------

local function requireShared(folder: Instance, name: string): any
	local inst = folder:FindFirstChild(name)
	if not inst or not inst:IsA("ModuleScript") then
		return nil
	end
	local ok, module = pcall(require, inst)
	if ok and type(module) == "table" then
		return module
	end
	return nil
end

local function resolveDecoders(): any
	if decoderOverride then
		return decoderOverride
	end
	if decoders then
		return decoders
	end
	local MeshData = requireShared(Shared, "MeshData")
	local PngDecoder = requireShared(Util, "PngDecoder")
	local MeshPack = if MeshData then requireShared(Shared:FindFirstChild("MeshData"), "MeshPack") else nil
	if not MeshData or not PngDecoder or not MeshPack then
		return nil
	end
	if type(MeshData.loadPart) ~= "function" or type(MeshData.index) ~= "function" then
		return nil
	end
	decoders = {
		list = function()
			return MeshData.list()
		end,
		index = function(id: string)
			return MeshData.index(id)
		end,
		loadPart = function(id: string, partName: string, options: any)
			return MeshData.loadPart(id, partName, options)
		end,
		loadTexture = function(id: string, options: any)
			return MeshData.loadTexture(id, options)
		end,
		decodePng = function(png: buffer, options: any)
			return PngDecoder.decode(png, options)
		end,
		decodeMesh = function(blob: buffer)
			return MeshPack.decode(blob)
		end,
	}
	return decoders
end

-- Replaces (table) or restores (nil) the decoder set; for specs.
function EmbeddedMeshController._setDecoders(override: any)
	decoderOverride = override
	decoders = nil
end

-- Forgets cached meshes and failures (specs).
function EmbeddedMeshController._reset()
	for id, parts in pairs(cache) do
		for _, part in pairs(parts) do
			pcall(function()
				part:Destroy()
			end)
		end
		cache[id] = nil
	end
	for id in pairs(ready) do
		ready[id] = nil
	end
	for id in pairs(textured) do
		textured[id] = nil
	end
	for id in pairs(holders) do
		holders[id] = nil
	end
	for id in pairs(failed) do
		failed[id] = nil
	end
	for id in pairs(loading) do
		loading[id] = nil
	end
	EmbeddedMeshController.DecodeStats = {}
end

-------------------------------------------------------------------------------
-- Placeholders
-------------------------------------------------------------------------------

local function placeholderId(placeholder: Instance): string?
	local id = placeholder:GetAttribute("EmbeddedMesh")
	if type(id) ~= "string" or id == "" then
		-- v1 vehicle placeholders carried only VehicleId.
		id = placeholder:GetAttribute("VehicleId")
	end
	if type(id) == "string" and id ~= "" then
		return id
	end
	return nil
end

local function placeholderPart(placeholder: Instance): string
	local name = placeholder:GetAttribute("EmbeddedPart")
	if type(name) == "string" and name ~= "" then
		return name
	end
	return EmbeddedMeshController.DEFAULT_PART
end

local function meshColorOf(placeholder: Instance): Color3?
	local color = placeholder:GetAttribute("MeshColor")
	if typeof(color) == "Color3" then
		return color
	end
	return nil
end

local function markFailed(placeholder: BasePart)
	placeholder.Transparency = EmbeddedMeshController.FAILED_TRANSPARENCY
	local color = meshColorOf(placeholder)
	if color then
		placeholder.Color = color
		placeholder.Material = Enum.Material.SmoothPlastic
	end
end

-- Applies the placeholder's MeshColor to an untextured clone.
local function applyColor(placeholder: Instance, clone: BasePart)
	local color = meshColorOf(placeholder)
	if color then
		clone.Color = color
		clone.Material = Enum.Material.SmoothPlastic
	end
end

-- Follows MeshColor changes on the placeholder (once per placeholder; the current clone is looked
-- up at change time so a re-dressed placeholder keeps working).
local function watchColor(placeholder: Instance)
	if colorWatched[placeholder] then
		return
	end
	local ok, connection = pcall(function()
		return placeholder:GetAttributeChangedSignal("MeshColor"):Connect(function()
			local clone = placeholder:FindFirstChild(EmbeddedMeshController.MESH_NAME)
			if clone and clone:IsA("BasePart") then
				applyColor(placeholder, clone)
			end
			if placeholder:IsA("BasePart") and placeholder.Transparency == EmbeddedMeshController.FAILED_TRANSPARENCY then
				markFailed(placeholder)
			end
		end)
	end)
	if ok then
		colorWatched[placeholder] = connection or true
	end
end

-- Attaches the cached mesh to one placeholder (no-op when not ready or already dressed).
local function dress(placeholder: Instance)
	if not placeholder:IsA("BasePart") then
		return
	end
	local id = placeholderId(placeholder)
	if not id then
		return
	end
	if placeholder:FindFirstChild(EmbeddedMeshController.MESH_NAME) then
		return
	end
	local partName = placeholderPart(placeholder)
	local parts = cache[id]
	local template = parts and parts[partName]
	if not template then
		if failed[id] then
			markFailed(placeholder)
			watchColor(placeholder)
		end
		return
	end
	local ok, err = pcall(function()
		local clone = template:Clone()
		clone.Name = EmbeddedMeshController.MESH_NAME
		clone.CFrame = placeholder.CFrame
		clone.CanCollide = false
		clone.CanQuery = false
		clone.CanTouch = false
		clone.Massless = true
		if not textured[id] then
			applyColor(placeholder, clone)
		end
		if placeholder.Anchored then
			clone.Anchored = true
		else
			clone.Anchored = false
			local weld = Instance.new("WeldConstraint")
			weld.Name = "MeshWeld"
			weld.Part0 = placeholder
			weld.Part1 = clone
			weld.Parent = clone
		end
		clone.Parent = placeholder
	end)
	if not ok then
		warn("[EmbeddedMeshController] " .. id .. "/" .. partName .. ": attach failed: " .. tostring(err))
		return
	end
	if not textured[id] then
		watchColor(placeholder)
	end
end

local function dressAll(entryId: string?)
	for _, placeholder in ipairs(CollectionService:GetTagged(EmbeddedMeshController.TAG)) do
		if entryId == nil or placeholderId(placeholder) == entryId then
			dress(placeholder)
		end
	end
end

-------------------------------------------------------------------------------
-- Build
-------------------------------------------------------------------------------

-- Returns a function that yields once at most every YIELD_BUDGET seconds of work.
local function makeYielder(): () -> ()
	local last = os.clock()
	return function()
		if os.clock() - last >= EmbeddedMeshController.YIELD_BUDGET then
			task.wait()
			last = os.clock()
		end
	end
end

local function toVector(t: any): Vector3?
	if typeof(t) == "Vector3" then
		return t
	end
	if type(t) == "table" and type(t[1]) == "number" and type(t[2]) == "number" and type(t[3]) == "number" then
		return Vector3.new(t[1], t[2], t[3])
	end
	return nil
end

-- Part size: the vehicle definition's mesh.body.size for a vehicle body (keeps the generated
-- offsets authoritative), else the index part's bounding box, else the decoded geometry's.
local function partSize(entryId: string, index: any, entry: any, geometry: any): Vector3
	if index.kind == "vehicle" and entry.name == EmbeddedMeshController.DEFAULT_PART then
		local def = VehicleDefinitions.get(entryId)
		local mesh = def and def.mesh
		if mesh and mesh.body and mesh.body.size then
			local s = mesh.body.size
			return Vector3.new(s[1], s[2], s[3])
		end
	end
	local bmin, bmax = toVector(entry.bboxMin), toVector(entry.bboxMax)
	if bmin and bmax then
		return bmax - bmin
	end
	if geometry and geometry.bboxMax and geometry.bboxMin then
		return geometry.bboxMax - geometry.bboxMin
	end
	return Vector3.new(1, 1, 1)
end

local function buildEditableMesh(geometry: any, yield: () -> ()): any
	-- No FixedSize option: a fixed-size EditableMesh cannot have vertices or faces added, and the
	-- part is produced through CreateMeshPartAsync(Content.fromObject(mesh)) which needs no such flag.
	local editableMesh = AssetService:CreateEditableMesh()
	local positions, normals, uvs, triangles = geometry.positions, geometry.normals, geometry.uvs, geometry.triangles
	local vertexCount = #positions
	local vertexIds = table.create(vertexCount)
	local normalIds = table.create(vertexCount)
	local uvIds = table.create(vertexCount)
	local batch = EmbeddedMeshController.BATCH
	for i = 1, vertexCount do
		vertexIds[i] = editableMesh:AddVertex(positions[i])
		normalIds[i] = editableMesh:AddNormal(normals[i] or Vector3.yAxis)
		uvIds[i] = editableMesh:AddUV(uvs[i] or Vector2.zero)
		if i % batch == 0 then
			yield()
		end
	end
	local faceCount = math.floor(#triangles / 3)
	for f = 1, faceCount do
		local base = (f - 1) * 3
		local a, b, c = triangles[base + 1], triangles[base + 2], triangles[base + 3]
		local va, vb, vc = vertexIds[a], vertexIds[b], vertexIds[c]
		if va and vb and vc then
			local faceId = editableMesh:AddTriangle(va, vb, vc)
			editableMesh:SetFaceNormals(faceId, { normalIds[a], normalIds[b], normalIds[c] })
			editableMesh:SetFaceUVs(faceId, { uvIds[a], uvIds[b], uvIds[c] })
		else
			error(string.format("triangle %d references a missing vertex (%s, %s, %s)", f, tostring(a), tostring(b), tostring(c)))
		end
		if f % batch == 0 then
			yield()
		end
	end
	return editableMesh
end

local function buildEditableImage(image: any): any
	local width, height = image.width, image.height
	local editableImage = AssetService:CreateEditableImage({ Size = Vector2.new(width, height) })
	editableImage:WritePixelsBuffer(Vector2.zero, Vector2.new(width, height), image.rgba)
	return editableImage
end

local function partEntries(index: any): { any }
	local out = {}
	if type(index.parts) == "table" then
		for _, entry in ipairs(index.parts) do
			if type(entry) == "table" and type(entry.name) == "string" then
				table.insert(out, entry)
			end
		end
	end
	if #out == 0 then
		error("index lists no parts")
	end
	return out
end

local function loadEntry(entryId: string, decoderSet: any)
	if ready[entryId] or failed[entryId] or loading[entryId] then
		return
	end
	loading[entryId] = true
	local stats = { geometrySeconds = 0, textureSeconds = 0, buildSeconds = 0, parts = 0 }
	EmbeddedMeshController.DecodeStats[entryId] = stats
	local yield = makeYielder()
	-- Every decoder reports progress through the same yielder, so base64 chunks, inflate blocks,
	-- the Adler-32 slices, unfilter rows and RGBA rows all give the scheduler a chance to run.
	local progressOptions = {
		onProgress = function()
			yield()
		end,
	}
	local built: { [string]: MeshPart } = {}
	local meshes = {}
	local ok, err = pcall(function()
		local index = decoderSet.index(entryId)
		if type(index) ~= "table" then
			error("no index")
		end
		local entries = partEntries(index)
		local hasTexture = type(index.texture) == "table"

		local editableImage = nil
		if hasTexture then
			local t0 = os.clock()
			local textureBlob = decoderSet.loadTexture(entryId, progressOptions)
			yield()
			local image = decoderSet.decodePng(textureBlob, progressOptions)
			stats.textureSeconds = os.clock() - t0
			yield()
			t0 = os.clock()
			editableImage = buildEditableImage(image)
			stats.buildSeconds += os.clock() - t0
			yield()
		end

		for _, entry in ipairs(entries) do
			local t0 = os.clock()
			local blob = decoderSet.loadPart(entryId, entry.name, progressOptions)
			yield()
			local geometry = decoderSet.decodeMesh(blob)
			stats.geometrySeconds += os.clock() - t0
			yield()

			t0 = os.clock()
			local editableMesh = buildEditableMesh(geometry, yield)
			local part = AssetService:CreateMeshPartAsync(Content.fromObject(editableMesh), {
				CollisionFidelity = Enum.CollisionFidelity.Box,
				RenderFidelity = Enum.RenderFidelity.Precise,
			})
			if typeof(part) ~= "Instance" or not part:IsA("MeshPart") then
				error("CreateMeshPartAsync returned no MeshPart")
			end
			if editableImage then
				part.TextureContent = Content.fromObject(editableImage)
			else
				part.Color = Color3.fromRGB(163, 162, 165)
				part.Material = Enum.Material.SmoothPlastic
			end
			part.Name = EmbeddedMeshController.MESH_NAME
			part.Size = partSize(entryId, index, entry, geometry)
			part.Anchored = false
			part.Massless = true
			part.CanCollide = false
			part.CanQuery = false
			part.CanTouch = false
			part.CastShadow = true
			part.Parent = nil
			stats.buildSeconds += os.clock() - t0
			built[entry.name] = part
			table.insert(meshes, editableMesh)
			stats.parts += 1
			yield()
		end
		holders[entryId] = { meshes = meshes, image = editableImage }
		textured[entryId] = hasTexture
		cache[entryId] = built
		ready[entryId] = true
	end)
	loading[entryId] = nil
	if not ok then
		for _, part in pairs(built) do
			pcall(function()
				part:Destroy()
			end)
		end
		failed[entryId] = true
		warn("[EmbeddedMeshController] " .. entryId .. ": embedded mesh failed, showing placeholder box: " .. tostring(err))
		for _, placeholder in ipairs(CollectionService:GetTagged(EmbeddedMeshController.TAG)) do
			if placeholderId(placeholder) == entryId and placeholder:IsA("BasePart") then
				markFailed(placeholder)
				watchColor(placeholder)
			end
		end
		return
	end
	EmbeddedMeshController.Loaded:Fire(entryId)
	dressAll(entryId)
end

-- PRIORITY ids that are in `ids` first (priority order), then the remaining ids in list order.
local function orderIds(ids: { string }): { string }
	local present = {}
	for _, id in ipairs(ids) do
		present[id] = true
	end
	local out = {}
	local taken = {}
	for _, id in ipairs(EmbeddedMeshController.PRIORITY) do
		if present[id] and not taken[id] then
			table.insert(out, id)
			taken[id] = true
		end
	end
	for _, id in ipairs(ids) do
		if not taken[id] then
			table.insert(out, id)
			taken[id] = true
		end
	end
	return out
end

-------------------------------------------------------------------------------
-- Public API
-------------------------------------------------------------------------------

-- The cached cosmetic MeshPart for (entry, part) (nil until decoded; clone it, never parent it).
function EmbeddedMeshController.GetMeshPart(entryId: string, partName: string?): MeshPart?
	local parts = cache[entryId]
	if not parts then
		return nil
	end
	return parts[partName or EmbeddedMeshController.DEFAULT_PART]
end

-- True when every part of the entry is built.
function EmbeddedMeshController.IsReady(entryId: string): boolean
	return ready[entryId] == true
end

function EmbeddedMeshController.HasFailed(entryId: string): boolean
	return failed[entryId] == true
end

-- Part names built for a ready entry (sorted; empty otherwise).
function EmbeddedMeshController.ListParts(entryId: string): { string }
	local names = {}
	for name in pairs(cache[entryId] or {}) do
		table.insert(names, name)
	end
	table.sort(names)
	return names
end

-- Entry ids with embedded data, in list order (empty when the data modules are absent).
function EmbeddedMeshController.ListEntries(): { string }
	local set = resolveDecoders()
	if not set then
		return {}
	end
	local ok, ids = pcall(set.list)
	if ok and type(ids) == "table" then
		return ids
	end
	return {}
end

-- Kept for callers from the vehicle-only version.
function EmbeddedMeshController.ListVehicles(): { string }
	return EmbeddedMeshController.ListEntries()
end

-- The decode order Start() uses for the given (or the listed) ids.
function EmbeddedMeshController.DecodeOrder(ids: { string }?): { string }
	return orderIds(ids or EmbeddedMeshController.ListEntries())
end

-- Starts (once) the background decode for one entry; returns false when nothing could start.
function EmbeddedMeshController.Load(entryId: string): boolean
	local set = resolveDecoders()
	if not set or ready[entryId] or failed[entryId] or loading[entryId] then
		return false
	end
	task.spawn(loadEntry, entryId, set)
	return true
end

-- Dresses every tagged placeholder whose mesh is ready (idempotent).
function EmbeddedMeshController.Refresh()
	dressAll(nil)
end

function EmbeddedMeshController.Init(context)
	ctx = context
end

function EmbeddedMeshController.Start()
	if started then
		return
	end
	started = true
	-- Attach first so placeholders that appear during the decode are never missed.
	tagConnection = CollectionService:GetInstanceAddedSignal(EmbeddedMeshController.TAG):Connect(function(placeholder)
		dress(placeholder)
	end)
	dressAll(nil)
	local set = resolveDecoders()
	if not set then
		warn("[EmbeddedMeshController] embedded mesh modules unavailable (Shared.MeshData v2 / Util.PngDecoder); placeholders stay as boxes")
		for _, placeholder in ipairs(CollectionService:GetTagged(EmbeddedMeshController.TAG)) do
			if placeholder:IsA("BasePart") then
				markFailed(placeholder)
			end
		end
		return
	end
	-- One background task decodes the entries one after another: each decode already yields every
	-- YIELD_BUDGET of work, and running them concurrently would stack several budgets into one frame.
	local ids = orderIds(EmbeddedMeshController.ListEntries())
	task.spawn(function()
		for _, entryId in ipairs(ids) do
			loadEntry(entryId, set)
		end
	end)
end

-- Specs: stops the tag listener and forgets state so a fresh Start() runs again.
function EmbeddedMeshController._stop()
	if tagConnection then
		tagConnection:Disconnect()
		tagConnection = nil
	end
	started = false
	EmbeddedMeshController._reset()
end

return EmbeddedMeshController

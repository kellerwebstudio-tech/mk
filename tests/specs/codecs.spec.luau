describe("Inflate", function()
	local Base64, Inflate, V

	beforeEach(function()
		Base64 = requireShared("Util/Base64")
		Inflate = requireShared("Util/Inflate")
		V = vectors()
	end)

	it("computes Adler-32", function()
		expect(Inflate.adler32(buffer.create(0))).toBe(1)
		expect(Inflate.adler32(bytes("Wikipedia"))).toBe(0x11E60398)
		local big = buffer.create(70000)
		for i = 0, 69999 do
			buffer.writeu8(big, i, i % 251)
		end
		-- sub-ranges agree with the whole
		expect(Inflate.adler32(big, 0, 70000)).toBe(Inflate.adler32(big))
		expect(Inflate.adler32(big, 70000 - 9, 9)).toBe(Inflate.adler32(bytes(buffer.readstring(big, 70000 - 9, 9))))
	end)

	for _, vec in ipairs(vectors().zlib) do
		it("decompresses: " .. vec.name, function()
			local stream = Base64.decode(vec.data)
			local out, adler = Inflate.zlibDecompress(stream)
			expect(buffer.len(out)).toBe(vec.length)
			expect(adler).toBe(vec.adler)
			expect(Inflate.adler32(out)).toBe(vec.adler)
			if vec.expected then
				expectBufferEquals(out, Base64.decode(vec.expected), vec.name)
			end
			-- the raw decoder reports how many bytes the deflate body occupied
			local raw, consumed = Inflate.inflateRaw(stream, 2)
			expect(consumed).toBe(buffer.len(stream) - 6)
			expectBufferEquals(raw, out, vec.name .. " (raw)")
		end)
	end

	it("calls onProgress about every 64 KB and at the end, in order", function()
		local vec
		for _, v in ipairs(V.zlib) do
			if v.name == "200 KB mixed" then
				vec = v
			end
		end
		local calls = {}
		local out = Inflate.zlibDecompress(Base64.decode(vec.data), {
			onProgress = function(done, total)
				table.insert(calls, { done, total })
			end,
			expectedSize = vec.length,
		})
		expect(buffer.len(out)).toBe(vec.length)
		expect(#calls).toBeGreaterThanOrEqual(3)
		local last = 0
		for _, call in ipairs(calls) do
			expect(call[1]).toBeGreaterThanOrEqual(last)
			expect(call[2]).toBe(vec.length)
			last = call[1]
		end
		expect(calls[#calls][1]).toBe(vec.length)
		-- an exact expectedSize means the output buffer is used as-is (no growth, no trim)
		expect(buffer.len(out)).toBe(vec.length)
	end)

	it("reports progress between Adler-32 slices of a large output (stored blocks)", function()
		-- A 600 KB zlib stream of stored blocks built here: header, stored blocks of 65535 bytes,
		-- big-endian Adler-32 trailer. The checksum pass runs in 256 KB slices and fires onProgress
		-- between them (doneBytes = the final size), so a caller can yield during it too.
		local size = 600000
		local payload = buffer.create(size)
		for i = 0, size - 1 do
			buffer.writeu8(payload, i, (i * 7 + i // 1000) % 251)
		end
		local blocks = {}
		local pos = 0
		while pos < size do
			local n = math.min(65535, size - pos)
			local final = pos + n >= size
			table.insert(blocks, string.char(if final then 1 else 0) .. string.pack("<I2I2", n, 65535 - n) .. buffer.readstring(payload, pos, n))
			pos += n
		end
		local adler = Inflate.adler32(payload)
		local stream = buffer.fromstring("\120\1" .. table.concat(blocks) .. string.pack(">I4", adler))
		local calls = {}
		local out, verified = Inflate.zlibDecompress(stream, {
			expectedSize = size,
			onProgress = function(done, total)
				table.insert(calls, { done, total })
			end,
		})
		expect(verified).toBe(adler)
		expectBufferEquals(out, payload, "stored stream")
		local atEnd = 0
		local last = 0
		for _, call in ipairs(calls) do
			expect(call[1]).toBeGreaterThanOrEqual(last)
			expect(call[2]).toBe(size)
			last = call[1]
			if call[1] == size then
				atEnd += 1
			end
		end
		-- inflateRaw alone reports the final size once or twice (its closing call, plus a stored
		-- block that crossed a 64 KB checkpoint exactly at the end); the three 256 KB checksum
		-- slices add exactly one call between each pair on top of that
		local rawAtEnd = 0
		Inflate.inflateRaw(stream, 2, {
			expectedSize = size,
			onProgress = function(done)
				if done == size then
					rawAtEnd += 1
				end
			end,
		})
		expect(rawAtEnd).toBeGreaterThanOrEqual(1)
		expect(atEnd).toBe(rawAtEnd + 2)
		-- without a callback the result is the same and nothing is called
		local plain = Inflate.zlibDecompress(stream)
		expectBufferEquals(plain, payload, "stored stream (no callback)")
	end)

	it("grows the output buffer from a small expectedSize", function()
		local vec
		for _, v in ipairs(V.zlib) do
			if v.name == "repeated patterns" then
				vec = v
			end
		end
		local out = Inflate.zlibDecompress(Base64.decode(vec.data), { expectedSize = 16 })
		expectBufferEquals(out, Base64.decode(vec.expected), "grown output")
	end)

	it("ignores bytes after the Adler-32 trailer and reports consumed bytes", function()
		local E = V.zlibErrors
		local stream = Base64.decode(E.withTrailing)
		local out = Inflate.zlibDecompress(stream)
		expect(buffer.tostring(out)).toBe(buffer.tostring(Base64.decode(E.goodExpected)))
		local raw, consumed = Inflate.inflateRaw(stream, 2)
		expect(consumed).toBe(E.rawConsumedBytes)
		expect(buffer.tostring(raw)).toBe(buffer.tostring(out))
	end)

	it("errors on a bad zlib header, adler mismatch, truncation and preset dictionaries", function()
		local E = V.zlibErrors
		expect(function()
			Inflate.zlibDecompress(Base64.decode(E.badHeader))
		end).toThrow("bad zlib header")
		expect(function()
			Inflate.zlibDecompress(Base64.decode(E.badCheck))
		end).toThrow("bad zlib header")
		expect(function()
			Inflate.zlibDecompress(Base64.decode(E.adlerMismatch))
		end).toThrow("adler32 mismatch")
		expect(function()
			Inflate.zlibDecompress(Base64.decode(E.truncated))
		end).toThrow("Inflate:")
		expect(function()
			Inflate.zlibDecompress(Base64.decode(E.presetDict))
		end).toThrow("preset dictionar")
		expect(function()
			Inflate.zlibDecompress(buffer.create(3))
		end).toThrow("bad zlib header")
		expect(function()
			Inflate.zlibDecompress("string")
		end).toThrow("expects a buffer")
		-- block type 3 is reserved
		local b = buffer.create(8)
		buffer.writeu8(b, 0, 0x78)
		buffer.writeu8(b, 1, 0x9C)
		buffer.writeu8(b, 2, 0x07)
		expect(function()
			Inflate.zlibDecompress(b)
		end).toThrow("invalid block type")
	end)
end)


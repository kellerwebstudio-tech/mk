--!strict
-- MeshData: index over the embedded vehicle mesh data generated by tools/mesh_embed.py.
--
-- Each vehicle with embedded data is a child ModuleScript of this module (MeshData.<VehicleId>)
-- returning its index table, with chunk ModuleScripts G1..Gn (DDCM geometry, see MeshPack) and
-- T1..Tn (PNG texture, see Util.PngDecoder) each returning one base64 string.
--
--   MeshData.list() -> { vehicleId }          vehicles with embedded data (sorted)
--   MeshData.has(vehicleId) -> boolean         never throws
--   MeshData.index(vehicleId) -> Index         the generated index table (errors when absent)
--   MeshData.loadGeometry(vehicleId, options?) -> buffer  the DDCM blob (G chunks, base64-decoded)
--   MeshData.loadTexture(vehicleId, options?) -> buffer   the PNG bytes (T chunks)
--     options = { onProgress: ((doneBytes, totalBytes) -> ())? }  -- fires after every decoded chunk
--
-- Decoded buffers are not cached (a texture is ~1.2 MB); callers keep what they need.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Base64 = require(Shared.Util.Base64)

local MeshData = {}

export type GeometryIndex = {
	chunks: number,
	bytes: number,
	vertexCount: number,
	triangleCount: number,
	bboxMin: { number },
	bboxMax: { number },
}
export type TextureIndex = { chunks: number, bytes: number, width: number, height: number, format: string }
export type Index = { vehicleId: string, version: number, geometry: GeometryIndex, texture: TextureIndex }

MeshData.VERSION = 1

-- A data module is a child ModuleScript that carries at least the first geometry chunk.
local function dataModule(vehicleId: string): ModuleScript?
	if type(vehicleId) ~= "string" then
		return nil
	end
	local child = script:FindFirstChild(vehicleId)
	if child and child:IsA("ModuleScript") and child:FindFirstChild("G1") then
		return child
	end
	return nil
end

function MeshData.list(): { string }
	local ids: { string } = {}
	for _, child in ipairs(script:GetChildren()) do
		if child:IsA("ModuleScript") and child:FindFirstChild("G1") then
			table.insert(ids, child.Name)
		end
	end
	table.sort(ids)
	return ids
end

function MeshData.has(vehicleId: string): boolean
	return dataModule(vehicleId) ~= nil
end

function MeshData.index(vehicleId: string): Index
	local module = dataModule(vehicleId)
	if not module then
		error(string.format("MeshData: no embedded data for vehicle %q", tostring(vehicleId)), 2)
	end
	local index = require(module) :: any
	if type(index) ~= "table" or type(index.geometry) ~= "table" or type(index.texture) ~= "table" then
		error(string.format("MeshData: %s is not a mesh data index", module:GetFullName()), 2)
	end
	if index.version ~= MeshData.VERSION then
		error(string.format("MeshData: %s has version %s, expected %d", vehicleId, tostring(index.version), MeshData.VERSION), 2)
	end
	return index :: Index
end

export type LoadOptions = { onProgress: ((doneBytes: number, totalBytes: number) -> ())? }

-- Decodes the base64 chunks <prefix>1..<prefix>count under the data module into one buffer. Every
-- chunk is decoded on its own (the generator cuts at multiples of 4 characters, so each chunk is a
-- whole number of quartets) and onProgress fires after each one, so a caller can task.wait()
-- between ~110 KB pieces instead of decoding 1.6 MB in one synchronous block. A chunk that is not
-- a whole number of quartets falls back to decoding the concatenation.
local function loadChunks(vehicleId: string, prefix: string, count: number, expectedBytes: number, options: LoadOptions?): buffer
	local module = dataModule(vehicleId) :: ModuleScript
	local parts: { string } = table.create(count)
	local splittable = true
	for i = 1, count do
		local chunk = module:FindFirstChild(prefix .. i)
		if not chunk or not chunk:IsA("ModuleScript") then
			error(string.format("MeshData: %s is missing chunk %s%d", vehicleId, prefix, i), 3)
		end
		local text = require(chunk) :: any
		if type(text) ~= "string" then
			error(string.format("MeshData: chunk %s.%s%d does not return a string", vehicleId, prefix, i), 3)
		end
		parts[i] = text
		if i < count and #text % 4 ~= 0 then
			splittable = false
		end
	end
	local onProgress = options and options.onProgress or nil
	local decoded: buffer
	if splittable and count > 1 then
		decoded = buffer.create(expectedBytes)
		local done = 0
		for i = 1, count do
			local piece = Base64.decode(parts[i])
			local n = buffer.len(piece)
			if done + n > expectedBytes then
				error(string.format("MeshData: %s %s data exceeds the %d bytes the index declares", vehicleId, prefix, expectedBytes), 3)
			end
			buffer.copy(decoded, done, piece, 0, n)
			done += n
			if onProgress then
				onProgress(done, expectedBytes)
			end
		end
		if done ~= expectedBytes then
			error(string.format("MeshData: %s %s data is %d bytes, index says %d", vehicleId, prefix, done, expectedBytes), 3)
		end
	else
		decoded = Base64.decode(table.concat(parts))
		if buffer.len(decoded) ~= expectedBytes then
			error(string.format("MeshData: %s %s data is %d bytes, index says %d", vehicleId, prefix, buffer.len(decoded), expectedBytes), 3)
		end
		if onProgress then
			onProgress(expectedBytes, expectedBytes)
		end
	end
	return decoded
end

function MeshData.loadGeometry(vehicleId: string, options: LoadOptions?): buffer
	local index = MeshData.index(vehicleId)
	return loadChunks(vehicleId, "G", index.geometry.chunks, index.geometry.bytes, options)
end

function MeshData.loadTexture(vehicleId: string, options: LoadOptions?): buffer
	local index = MeshData.index(vehicleId)
	return loadChunks(vehicleId, "T", index.texture.chunks, index.texture.bytes, options)
end

return MeshData

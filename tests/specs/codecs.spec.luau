describe("Base64", function()
	local Base64, V

	beforeEach(function()
		Base64 = requireShared("Util/Base64")
		V = vectors().base64
	end)

	it("round-trips the RFC 4648 vectors and the full byte table", function()
		for _, vec in ipairs(V.vectors) do
			local decoded = Base64.decode(vec.encoded)
			expect(Base64.encode(decoded)).toBe(vec.encoded)
			-- `raw` is itself base64 of the raw bytes (binary cannot live in the fixture source)
			expectBufferEquals(decoded, Base64.decode(vec.raw), vec.encoded)
		end
		-- independent spot checks against the RFC examples
		expect(buffer.tostring(Base64.decode("Zm9vYmFy"))).toBe("foobar")
		expect(buffer.tostring(Base64.decode("Zm9vYg=="))).toBe("foob")
		expect(buffer.tostring(Base64.decode("Zg=="))).toBe("f")
		expect(Base64.encode(bytes("foobar"))).toBe("Zm9vYmFy")
		expect(Base64.encode(bytes("fooba"))).toBe("Zm9vYmE=")
		expect(Base64.encode(bytes("foob"))).toBe("Zm9vYg==")
		expect(Base64.encode(buffer.create(0))).toBe("")
		local all = buffer.create(256)
		for i = 0, 255 do
			buffer.writeu8(all, i, i)
		end
		expectBufferEquals(Base64.decode(Base64.encode(all)), all, "byte table")
	end)

	it("ignores whitespace and accepts unpadded input", function()
		expect(buffer.tostring(Base64.decode(V.whitespace))).toBe(buffer.tostring(Base64.decode(V.whitespaceExpected)))
		expect(buffer.tostring(Base64.decode(V.unpadded))).toBe(buffer.tostring(Base64.decode(V.unpaddedExpected)))
		expect(buffer.len(Base64.decode(""))).toBe(0)
		expect(buffer.len(Base64.decode("  \n"))).toBe(0)
	end)

	it("errors on invalid characters and lengths", function()
		expect(function()
			Base64.decode(V.badChar)
		end).toThrow("invalid character")
		expect(function()
			Base64.decode(V.badLength)
		end).toThrow("length")
		expect(function()
			Base64.decode("Zm=v")
		end).toThrow("invalid character")
		expect(function()
			Base64.decode(42)
		end).toThrow("expects a string")
		expect(function()
			Base64.encode("not a buffer")
		end).toThrow("expects a buffer")
	end)
end)


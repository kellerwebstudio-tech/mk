describe("PngDecoder", function()
	local Base64, Inflate, PngDecoder, V

	beforeEach(function()
		Base64 = requireShared("Util/Base64")
		Inflate = requireShared("Util/Inflate")
		PngDecoder = requireShared("Util/PngDecoder")
		V = vectors()
	end)

	for _, vec in ipairs(vectors().png) do
		it("decodes " .. vec.name, function()
			local image = PngDecoder.decode(Base64.decode(vec.data))
			expect(image.width).toBe(vec.width)
			expect(image.height).toBe(vec.height)
			expect(image.colorType).toBe(vec.colorType)
			expect(buffer.len(image.rgba)).toBe(vec.width * vec.height * 4)
			expectBufferEquals(image.rgba, Base64.decode(vec.rgba), vec.name)
			expect(Inflate.adler32(image.rgba)).toBe(vec.rgbaAdler)
		end)
	end

	it("reports progress from 0 to 1 in order", function()
		local vec = V.png[#V.png]
		local calls = {}
		PngDecoder.decode(Base64.decode(vec.data), {
			onProgress = function(fraction)
				table.insert(calls, fraction)
			end,
		})
		expect(#calls).toBeGreaterThanOrEqual(2)
		local last = -1
		for _, f in ipairs(calls) do
			expect(f).toBeGreaterThanOrEqual(last)
			expect(f).toBeLessThanOrEqual(1)
			last = f
		end
		expect(calls[#calls]).toBe(1)
	end)

	it("rejects palette, interlaced and 16-bit PNGs and corrupt data with clear errors", function()
		local E = V.pngErrors
		local good = PngDecoder.decode(Base64.decode(E.good))
		expectBufferEquals(good.rgba, Base64.decode(E.goodRgba), "good")
		expect(function()
			PngDecoder.decode(Base64.decode(E.palette))
		end).toThrow("palette")
		expect(function()
			PngDecoder.decode(Base64.decode(E.interlaced))
		end).toThrow("interlaced")
		expect(function()
			PngDecoder.decode(Base64.decode(E.sixteenBit))
		end).toThrow("bit depth 16")
		expect(function()
			PngDecoder.decode(Base64.decode(E.badSignature))
		end).toThrow("not a PNG")
		expect(function()
			PngDecoder.decode(Base64.decode(E.shortData))
		end).toThrow("expected")
		expect(function()
			PngDecoder.decode(Base64.decode(E.adlerMismatch))
		end).toThrow("adler32 mismatch")
		expect(function()
			PngDecoder.decode("nope")
		end).toThrow("expects a buffer")
		expect(function()
			PngDecoder.decode(buffer.create(4))
		end).toThrow("too short")
	end)
end)


--!strict
-- MeshData: index over the embedded mesh data generated by tools/mesh_embed.py (index version 2).
--
-- Each entry (a vehicle body, an NPC figure or an accessory) is a child ModuleScript of this module
-- (MeshData.<Id>) returning its index table, with one base64 chunk ModuleScript per piece of data:
--   <Part>_G<n>  the DDCM geometry blob of one part (see MeshPack), e.g. Body_G1, LegL_G1
--   T<n>         the PNG texture (see Util.PngDecoder), absent for untextured entries
--
--   MeshData.list() -> { id }                  entries with embedded data (sorted); never throws
--   MeshData.has(id) -> boolean                never throws
--   MeshData.index(id) -> Index                the generated index table (errors when absent)
--   MeshData.kind(id) -> "vehicle" | "figure" | "accessory"
--   MeshData.parts(id) -> { PartIndex }        the entry's parts in index order (Body first)
--   MeshData.part(id, name) -> PartIndex?      one part entry, nil when the entry has no such part
--   MeshData.loadPart(id, name, options?) -> buffer   the part's DDCM blob (its chunks, base64-decoded)
--   MeshData.loadGeometry(id, options?) -> buffer     alias of loadPart(id, "Body", options)
--   MeshData.loadTexture(id, options?) -> buffer?     the PNG bytes, nil when the entry has no texture
--     options = { onProgress: ((doneBytes, totalBytes) -> ())? }  -- fires after every decoded chunk
--
-- Coordinates: every part's bboxMin/bboxMax (and a figure's leg `pivot`, the hip point) are in the
-- entry's own frame (vehicle: chassis centre; figure: between the feet on the ground, -Z forward;
-- accessory: mesh centre). A leg blob is written relative to its pivot, so the decoded positions
-- are centred near (bboxCentre - pivot) and a MeshPart made from it sits on its own bounds.
-- Decoded buffers are not cached (a texture is ~1.2 MB); callers keep what they need.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Base64 = require(Shared.Util.Base64)

local MeshData = {}

export type Kind = "vehicle" | "figure" | "accessory"
export type PartIndex = {
	name: string,
	chunks: { string },
	bytes: number,
	vertexCount: number,
	triangleCount: number,
	bboxMin: { number },
	bboxMax: { number },
	pivot: { number }?,
}
export type TextureIndex = { chunks: number, bytes: number, width: number, height: number, format: string }
export type Index = {
	id: string,
	version: number,
	kind: Kind,
	texture: TextureIndex?,
	bboxMin: { number },
	bboxMax: { number },
	parts: { PartIndex },
}
export type LoadOptions = { onProgress: ((doneBytes: number, totalBytes: number) -> ())? }

MeshData.VERSION = 2

local KINDS: { [string]: boolean } = { vehicle = true, figure = true, accessory = true }

-- Requires a child ModuleScript and returns its table when it is a version-2 index, else nil.
-- Never throws: a module that errors or returns something else is not an entry (MeshPack lives
-- here too and returns a decoder table without a version).
local function indexOf(child: Instance): Index?
	if not child:IsA("ModuleScript") then
		return nil
	end
	local ok, index = pcall(require, child)
	if not ok or type(index) ~= "table" then
		return nil
	end
	local candidate = index :: any
	if candidate.version ~= MeshData.VERSION or type(candidate.parts) ~= "table" or type(candidate.id) ~= "string" then
		return nil
	end
	return candidate :: Index
end

local function dataModule(id: string): ModuleScript?
	if type(id) ~= "string" then
		return nil
	end
	local child = script:FindFirstChild(id)
	if child and child:IsA("ModuleScript") and indexOf(child) ~= nil then
		return child
	end
	return nil
end

function MeshData.list(): { string }
	local ids: { string } = {}
	for _, child in ipairs(script:GetChildren()) do
		if indexOf(child) ~= nil then
			table.insert(ids, child.Name)
		end
	end
	table.sort(ids)
	return ids
end

function MeshData.has(id: string): boolean
	return dataModule(id) ~= nil
end

local function unknown(id: any, level: number): never
	error(string.format("MeshData: no embedded data for %q", tostring(id)), level + 1)
end

-- Validates the shape of an index table once per require (require caches the table itself).
local validated: { [any]: boolean } = setmetatable({}, { __mode = "k" }) :: any

local function validate(id: string, module: ModuleScript, index: Index, level: number)
	if validated[index] then
		return
	end
	local name = module:GetFullName()
	if index.id ~= id then
		error(string.format("MeshData: %s declares id %q, expected %q", name, tostring(index.id), id), level + 1)
	end
	if not KINDS[index.kind] then
		error(string.format("MeshData: %s has unknown kind %q", name, tostring(index.kind)), level + 1)
	end
	if type(index.bboxMin) ~= "table" or type(index.bboxMax) ~= "table" then
		error(string.format("MeshData: %s has no bounding box", name), level + 1)
	end
	if #index.parts == 0 then
		error(string.format("MeshData: %s has no parts", name), level + 1)
	end
	for i, part in ipairs(index.parts) do
		if type(part) ~= "table" or type(part.name) ~= "string" or type(part.chunks) ~= "table" or #part.chunks == 0 or type(part.bytes) ~= "number" then
			error(string.format("MeshData: %s part #%d is malformed", name, i), level + 1)
		end
	end
	local texture = index.texture
	if texture ~= nil and (type(texture) ~= "table" or type(texture.chunks) ~= "number" or type(texture.bytes) ~= "number") then
		error(string.format("MeshData: %s has a malformed texture entry", name), level + 1)
	end
	validated[index] = true
end

local function resolve(id: string, level: number): (ModuleScript, Index)
	if type(id) ~= "string" then
		unknown(id, level + 1)
	end
	local child = script:FindFirstChild(id)
	if not child or not child:IsA("ModuleScript") then
		unknown(id, level + 1)
	end
	local module = child :: ModuleScript
	local ok, raw = pcall(require, module)
	if not ok then
		error(string.format("MeshData: %s failed to load: %s", module:GetFullName(), tostring(raw)), level + 1)
	end
	if type(raw) ~= "table" or type((raw :: any).parts) ~= "table" then
		unknown(id, level + 1)
	end
	local index = raw :: Index
	if index.version ~= MeshData.VERSION then
		error(string.format("MeshData: %s has version %s, expected %d", id, tostring(index.version), MeshData.VERSION), level + 1)
	end
	validate(id, module, index, level + 1)
	return module, index
end

function MeshData.index(id: string): Index
	local _, index = resolve(id, 2)
	return index
end

function MeshData.kind(id: string): Kind
	local _, index = resolve(id, 2)
	return index.kind
end

function MeshData.parts(id: string): { PartIndex }
	local _, index = resolve(id, 2)
	return index.parts
end

local function findPart(index: Index, name: string): PartIndex?
	for _, part in ipairs(index.parts) do
		if part.name == name then
			return part
		end
	end
	return nil
end

function MeshData.part(id: string, name: string): PartIndex?
	local _, index = resolve(id, 2)
	return findPart(index, name)
end

-- Decodes the base64 chunk ModuleScripts `chunkNames` under `module` into one buffer. Every chunk is
-- decoded on its own (the generator cuts at multiples of 4 characters, so each chunk is a whole
-- number of quartets) and onProgress fires after each one, so a caller can task.wait() between
-- ~110 KB pieces instead of decoding 1.6 MB in one synchronous block. A chunk that is not a whole
-- number of quartets falls back to decoding the concatenation.
local function loadChunks(id: string, module: ModuleScript, label: string, chunkNames: { string }, expectedBytes: number, options: LoadOptions?): buffer
	local count = #chunkNames
	local parts: { string } = table.create(count)
	local splittable = true
	for i, chunkName in ipairs(chunkNames) do
		local chunk = module:FindFirstChild(chunkName)
		if not chunk or not chunk:IsA("ModuleScript") then
			error(string.format("MeshData: %s is missing chunk %s", id, chunkName), 3)
		end
		local text = require(chunk) :: any
		if type(text) ~= "string" then
			error(string.format("MeshData: chunk %s.%s does not return a string", id, chunkName), 3)
		end
		parts[i] = text
		if i < count and #text % 4 ~= 0 then
			splittable = false
		end
	end
	local onProgress = options and options.onProgress or nil
	local decoded: buffer
	if splittable and count > 1 then
		decoded = buffer.create(expectedBytes)
		local done = 0
		for i = 1, count do
			local piece = Base64.decode(parts[i])
			local n = buffer.len(piece)
			if done + n > expectedBytes then
				error(string.format("MeshData: %s %s data exceeds the %d bytes the index declares", id, label, expectedBytes), 3)
			end
			buffer.copy(decoded, done, piece, 0, n)
			done += n
			if onProgress then
				onProgress(done, expectedBytes)
			end
		end
		if done ~= expectedBytes then
			error(string.format("MeshData: %s %s data is %d bytes, index says %d", id, label, done, expectedBytes), 3)
		end
	else
		decoded = Base64.decode(table.concat(parts))
		if buffer.len(decoded) ~= expectedBytes then
			error(string.format("MeshData: %s %s data is %d bytes, index says %d", id, label, buffer.len(decoded), expectedBytes), 3)
		end
		if onProgress then
			onProgress(expectedBytes, expectedBytes)
		end
	end
	return decoded
end

function MeshData.loadPart(id: string, name: string, options: LoadOptions?): buffer
	local module, index = resolve(id, 2)
	local part = findPart(index, name)
	if not part then
		error(string.format("MeshData: %s has no part %q", id, tostring(name)), 2)
	end
	return loadChunks(id, module, part.name, part.chunks, part.bytes, options)
end

function MeshData.loadGeometry(id: string, options: LoadOptions?): buffer
	return MeshData.loadPart(id, "Body", options)
end

function MeshData.loadTexture(id: string, options: LoadOptions?): buffer?
	local module, index = resolve(id, 2)
	local texture = index.texture
	if texture == nil then
		return nil
	end
	local names: { string } = table.create(texture.chunks)
	for i = 1, texture.chunks do
		names[i] = "T" .. i
	end
	return loadChunks(id, module, "texture", names, texture.bytes, options)
end

return MeshData

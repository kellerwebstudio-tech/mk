describe("DataStoreService", function()
	it("SetAsync/GetAsync/UpdateAsync/IncrementAsync/RemoveAsync on an in-memory store", function()
		local store = game:GetService("DataStoreService"):GetDataStore("DDC_Profiles_v1")
		expect(store:GetAsync("u_1")).toBeNil()
		store:SetAsync("u_1", { cash = 10, list = { 1, 2 } })
		local v, info = store:GetAsync("u_1")
		expect(v).toEqual({ cash = 10, list = { 1, 2 } })
		expect(typeof(info)).toBe("DataStoreKeyInfo")
		v.cash = 999 -- copies: the store must not change
		expect(store:GetAsync("u_1").cash).toBe(10)
		expect(shim.datastore.data.DDC_Profiles_v1.u_1.cash).toBe(10)
		local result = store:UpdateAsync("u_1", function(old)
			expect(old.cash).toBe(10)
			old.cash += 5
			return old
		end)
		expect(result.cash).toBe(15)
		expect(store:GetAsync("u_1").cash).toBe(15)
		-- returning nil cancels the update
		local cancelled = store:UpdateAsync("u_1", function() return nil end)
		expect(cancelled).toBeNil()
		expect(store:GetAsync("u_1").cash).toBe(15)
		expect(store:IncrementAsync("counter", 3)).toBe(3)
		expect(store:IncrementAsync("counter")).toBe(4)
		store:RemoveAsync("u_1")
		expect(store:GetAsync("u_1")).toBeNil()
		expect(function() store:SetAsync("bad", { fn = function() end }) end).toThrow("Cannot store")
		expect(game:GetService("DataStoreService"):GetDataStore("DDC_Profiles_v1")).toBe(store)
		expect(game:GetService("DataStoreService"):GetDataStore("Other", "scope")).never.toBe(store)
	end)

	it("failure injection and latency", function()
		local store = game:GetService("DataStoreService"):GetDataStore("Profiles")
		shim.datastore.failNextCalls = 2
		expect(function() store:GetAsync("k") end).toThrow("DataStore request failed (simulated)")
		expect(function() store:UpdateAsync("k", function() return 1 end) end).toThrow("simulated")
		expect(store:GetAsync("k")).toBeNil()
		expect(shim.datastore.failNextCalls).toBe(0)
		shim.datastore.latency = 0.5
		local t0 = os.clock()
		store:SetAsync("k", 1)
		expect(os.clock() - t0).toBeCloseTo(0.5)
		expect(#shim.datastore.calls).toBe(4)
		expect(shim.datastore.calls[4].method).toBe("SetAsync")
		local ordered = game:GetService("DataStoreService"):GetOrderedDataStore("Scores")
		ordered:SetAsync("a", 5)
		ordered:SetAsync("b", 9)
		ordered:SetAsync("c", 1)
		local page = ordered:GetSortedAsync(false, 10):GetCurrentPage()
		expect(page[1].key).toBe("b")
		expect(page[3].value).toBe(1)
	end)

	it("state is isolated between tests by shim.reset", function()
		local store = game:GetService("DataStoreService"):GetDataStore("Profiles")
		expect(store:GetAsync("k")).toBeNil()
		expect(shim.datastore.latency).toBe(0)
		expect(workspace:FindFirstChild("Sitter")).toBeNil()
		expect(#game:GetService("Players"):GetPlayers()).toBe(0)
		expect(os.clock()).toBe(1000)
	end)
end)

describe("HttpService JSON", function()
	it("round-trips nested data", function()
		local Http = game:GetService("HttpService")
		local data = { name = "Dash", n = 3, f = 1.5, ok = true, list = { 1, "two", false, { deep = "yes" } }, obj = { a = { b = { c = "d" } } }, empty = {} }
		local encoded = Http:JSONEncode(data)
		expect(encoded).toContain('"name":"Dash"')
		local decoded = Http:JSONDecode(encoded)
		expect(decoded.name).toBe("Dash")

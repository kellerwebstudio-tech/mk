--!strict
-- FigureRig: builds the placeholder rig for an embedded people mesh (Shared.MeshData entries of
-- kind "figure": Body + LegL + LegR, generated by tools/mesh_embed.py) and animates its legs.
-- Usable on the server (static staff / drivers) and on the client (pedestrians, door customers).
--
-- Model layout (FigureRig.build):
--   Model "<name>" (attribute FigureId = entry id, PrimaryPart Root)
--     Root  invisible 2x2x1 Part, centre ROOT_HEIGHT above the feet, Anchored per options
--     Body  invisible placeholder Part (size = the part's bbox), WeldConstraint "BodyWeld" to Root
--     LegL  invisible placeholder, Motor6D "LeftHip"  (Part0 = Root, Part1 = LegL) inside the leg
--     LegR  invisible placeholder, Motor6D "RightHip" (Part0 = Root, Part1 = LegR) inside the leg
-- Every placeholder carries the attributes EmbeddedMesh = entry id and EmbeddedPart = part name
-- plus the tag "EmbeddedMeshBody": the client EmbeddedMeshController rebuilds the mesh part from the
-- embedded data and welds a clone to the placeholder (anchored when the placeholder is anchored).
--
-- Geometry: the index stores every part's bboxMin/bboxMax in figure coordinates (origin between
-- the feet on the ground, -Z forward) and, for the legs, `pivot` = the hip point. A MeshPart built
-- from a part blob is centred on that part's bounding box, so a placeholder sits at its bboxCentre.
-- The hip Motor6Ds use C0 = pivot - rootCentre and C1 = pivot - bboxCentre, which gives
--   leg.CFrame = Root.CFrame * C0 * Transform * C1:Inverse()
-- the leg at rest in place (Transform = identity) and a Transform = CFrame.Angles(swing, 0, 0)
-- swinging it about the hip point.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")

local Shared = ReplicatedStorage:WaitForChild("Shared")

local FigureRig = {}

export type BuildOptions = { name: string?, anchored: boolean?, collisionGroup: string? }

-- Height of the Root centre above the feet (matches NPCBuilder.ROOT_HEIGHT).
FigureRig.ROOT_HEIGHT = 3
FigureRig.TAG = "EmbeddedMeshBody"
FigureRig.MESH_DATA_MODULE = "MeshData"
FigureRig.DEFAULT_AMPLITUDE = 0.55
-- Motor6D names per leg part; any other pivoted part gets "<Part>Joint".
FigureRig.MOTOR_NAMES = { LegL = "LeftHip", LegR = "RightHip" }

FigureRig.FIGURE_IDS = {
	Staff = { "NPCStaff" },
	Worker = { "NPCWorker" },
	Driver = { "NPCDriver" },
	Customer = { "NPCCustomerA", "NPCCustomerB" },
	Pedestrian = { "NPCPedestrianA", "NPCPedestrianB", "NPCPedestrianC" },
}

-------------------------------------------------------------------------------
-- MeshData access (lazy: the module is large and optional)
-------------------------------------------------------------------------------

local meshDataCache: any = nil
local meshDataOverride: any = nil

-- The Shared.MeshData module, or nil when it is absent or broken. Specs inject a stand-in with
-- FigureRig._setMeshData(module) (nil restores the lazy lookup).
function FigureRig.getMeshData(): any
	if meshDataOverride ~= nil then
		return meshDataOverride
	end
	if meshDataCache ~= nil then
		return meshDataCache
	end
	local ok, module = pcall(function()
		local inst = Shared:FindFirstChild(FigureRig.MESH_DATA_MODULE)
		if inst and inst:IsA("ModuleScript") then
			return (require :: any)(inst)
		end
		return nil
	end)
	if ok and type(module) == "table" and type(module.has) == "function" then
		meshDataCache = module
		return module
	end
	return nil
end

function FigureRig._setMeshData(module: any)
	meshDataOverride = module
	meshDataCache = nil
end

-- True when embedded data exists for `entryId` (and, when given, is of `kind`). Never throws.
function FigureRig.hasEntry(entryId: string, kind: string?): boolean
	if type(entryId) ~= "string" or entryId == "" then
		return false
	end
	local meshData = FigureRig.getMeshData()
	if not meshData then
		return false
	end
	local okHas, has = pcall(meshData.has, entryId)
	if not okHas or has ~= true then
		return false
	end
	if kind == nil then
		return true
	end
	if type(meshData.kind) ~= "function" then
		return false
	end
	local okKind, entryKind = pcall(meshData.kind, entryId)
	return okKind and entryKind == kind
end

-- True when `entryId` is an embedded figure (kind "figure").
function FigureRig.has(entryId: string): boolean
	return FigureRig.hasEntry(entryId, "figure")
end

-- The embedded figure id for an NPC kind and appearance seed (Customer A/B, Pedestrian A/B/C).
function FigureRig.idForKind(kind: string, seed: number?): string
	local ids = FigureRig.FIGURE_IDS[kind] or FigureRig.FIGURE_IDS.Pedestrian
	local n = if type(seed) == "number" and seed == seed then math.floor(math.abs(seed)) else 0
	return ids[n % #ids + 1]
end

-------------------------------------------------------------------------------
-- Build
-------------------------------------------------------------------------------

local function vec(t: any): Vector3
	if typeof(t) == "Vector3" then
		return t
	end
	return Vector3.new(tonumber(t[1]) or 0, tonumber(t[2]) or 0, tonumber(t[3]) or 0)
end

local function stylePart(part: BasePart, collisionGroup: string?)
	part.Massless = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	if collisionGroup then
		pcall(function()
			part.CollisionGroup = collisionGroup
		end)
	end
end

-- Invisible placeholder for one index part, sized to the part's bounding box.
local function makePlaceholder(entryId: string, entry: any, collisionGroup: string?): Part
	local part = Instance.new("Part")
	part.Name = entry.name
	part.Shape = Enum.PartType.Block
	local size = vec(entry.bboxMax) - vec(entry.bboxMin)
	part.Size = Vector3.new(math.max(size.X, 0.05), math.max(size.Y, 0.05), math.max(size.Z, 0.05))
	part.Transparency = 1
	part.Color = Color3.fromRGB(163, 162, 165)
	part.Material = Enum.Material.SmoothPlastic
	part.Anchored = false
	part.CastShadow = false
	stylePart(part, collisionGroup)
	part:SetAttribute("EmbeddedMesh", entryId)
	part:SetAttribute("EmbeddedPart", entry.name)
	CollectionService:AddTag(part, FigureRig.TAG)
	return part
end

--[[
	Builds the placeholder rig for an embedded figure. The model has no Parent; its feet are at the
	origin (Root centre at (0, ROOT_HEIGHT, 0)) until FigureRig.place / PivotTo moves it.
	options = { name?, anchored? (Root, default true), collisionGroup? (every part) }
]]
function FigureRig.build(entryId: string, options: BuildOptions?): Model
	local meshData = FigureRig.getMeshData()
	if not meshData then
		error(string.format("FigureRig: Shared.MeshData is unavailable (cannot build %s)", tostring(entryId)), 2)
	end
	local index = meshData.index(entryId)
	if type(index) ~= "table" or type(index.parts) ~= "table" then
		error(string.format("FigureRig: %s has no parts index", tostring(entryId)), 2)
	end
	local opts: BuildOptions = options or {}
	local collisionGroup = opts.collisionGroup
	local rootCentre = Vector3.new(0, FigureRig.ROOT_HEIGHT, 0)

	local model = Instance.new("Model")
	model.Name = opts.name or entryId
	model:SetAttribute("FigureId", entryId)

	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(2, 2, 1)
	root.Transparency = 1
	root.CastShadow = false
	root.Anchored = opts.anchored ~= false
	stylePart(root, collisionGroup)
	root.CFrame = CFrame.new(rootCentre)
	root.Parent = model
	model.PrimaryPart = root

	for _, entry in ipairs(index.parts) do
		if type(entry) == "table" and type(entry.name) == "string" then
			local part = makePlaceholder(entryId, entry, collisionGroup)
			local bboxCentre = (vec(entry.bboxMin) + vec(entry.bboxMax)) / 2
			if entry.pivot ~= nil then
				-- Jointed part (legs): the Motor6D pivots about the hip point.
				local pivot = vec(entry.pivot)
				local c0 = CFrame.new(pivot - rootCentre)
				local c1 = CFrame.new(pivot - bboxCentre)
				part.CFrame = root.CFrame * c0 * c1:Inverse()
				part.Parent = model
				local motor = Instance.new("Motor6D")
				motor.Name = FigureRig.MOTOR_NAMES[entry.name] or (entry.name .. "Joint")
				motor.Part0 = root
				motor.Part1 = part
				motor.C0 = c0
				motor.C1 = c1
				motor.Parent = part
			else
				-- Rigid part (Body): welded to the Root at its bbox centre.
				part.CFrame = root.CFrame * CFrame.new(bboxCentre - rootCentre)
				part.Parent = model
				local weld = Instance.new("WeldConstraint")
				weld.Name = "BodyWeld"
				weld.Part0 = root
				weld.Part1 = part
				weld.Parent = part
			end
		end
	end
	return model
end

-------------------------------------------------------------------------------
-- Pose / placement
-------------------------------------------------------------------------------

local function findMotor(model: Model, partName: string, motorName: string): Motor6D?
	local part = model:FindFirstChild(partName)
	if part then
		local motor = part:FindFirstChild(motorName)
		if motor and motor:IsA("Motor6D") then
			return motor
		end
	end
	local found = model:FindFirstChild(motorName, true)
	if found and found:IsA("Motor6D") then
		return found
	end
	return nil
end

-- Swings the legs from sin(phase) (radians); amplitude defaults to DEFAULT_AMPLITUDE.
function FigureRig.setWalkPose(model: Model, phase: number, amplitude: number?)
	local amp = amplitude or FigureRig.DEFAULT_AMPLITUDE
	local swing = math.sin(phase) * amp
	local left = findMotor(model, "LegL", "LeftHip")
	if left then
		left.Transform = CFrame.Angles(swing, 0, 0)
	end
	local right = findMotor(model, "LegR", "RightHip")
	if right then
		right.Transform = CFrame.Angles(-swing, 0, 0)
	end
end

-- Resets the legs to standing.
function FigureRig.setIdlePose(model: Model)
	local left = findMotor(model, "LegL", "LeftHip")
	if left then
		left.Transform = CFrame.identity
	end
	local right = findMotor(model, "LegR", "RightHip")
	if right then
		right.Transform = CFrame.identity
	end
end

-- Pivots the model so the feet rest on `position` and it looks along the flat `facing`.
function FigureRig.place(model: Model, position: Vector3, facing: Vector3?)
	local look = facing or Vector3.new(0, 0, -1)
	look = Vector3.new(look.X, 0, look.Z)
	if look.Magnitude < 1e-3 then
		look = Vector3.new(0, 0, -1)
	end
	local origin = position + Vector3.new(0, FigureRig.ROOT_HEIGHT, 0)
	model:PivotTo(CFrame.lookAt(origin, origin + look.Unit))
end

return FigureRig

describe("CollectionService", function()
	it("tags are visible only inside the DataModel and signals fire on entry/exit", function()
		local CollectionService = game:GetService("CollectionService")
		local addedList, removedList = {}, {}
		CollectionService:GetInstanceAddedSignal("Package"):Connect(function(i) table.insert(addedList, i) end)
		CollectionService:GetInstanceRemovedSignal("Package"):Connect(function(i) table.insert(removedList, i) end)
		local p = Instance.new("Part")
		CollectionService:AddTag(p, "Package")
		expect(CollectionService:HasTag(p, "Package")).toBe(true)
		expect(CollectionService:GetTagged("Package")).toEqual({})
		expect(#addedList).toBe(0)
		p.Parent = workspace
		expect(CollectionService:GetTagged("Package")).toEqual({ p })
		expect(addedList).toEqual({ p })
		local q = Instance.new("Part", workspace)
		q:AddTag("Package")
		expect(addedList).toEqual({ p, q })
		expect(#CollectionService:GetTagged("Package")).toBe(2)
		CollectionService:RemoveTag(p, "Package")
		expect(removedList).toEqual({ p })
		q:Destroy()
		expect(removedList).toEqual({ p, q })
		expect(CollectionService:GetTagged("Package")).toEqual({})
		expect(CollectionService:GetAllTags()).toEqual({})
	end)
end)

describe("Remotes", function()
	it("RemoteEvent and RemoteFunction bridge client and server in one process", function()
		shim.setContext("client")
		local lp = game:GetService("Players").LocalPlayer
		local remotes = Instance.new("Folder", game:GetService("ReplicatedStorage"))
		remotes.Name = "Remotes"
		local ev = Instance.new("RemoteEvent", remotes)
		ev.Name = "OrdersUpdated"
		local fn = Instance.new("RemoteFunction", remotes)
		fn.Name = "AcceptOrder"
		local serverGot = {}
		ev.OnServerEvent:Connect(function(player, payload) table.insert(serverGot, { player, payload }) end)
		local payload = { vehicleSpeed = 12 }
		ev:FireServer(payload)
		expect(serverGot[1][1]).toBe(lp)
		expect(serverGot[1][2]).toEqual(payload)
		expect(serverGot[1][2]).never.toBe(payload) -- deep copied like real replication
		local clientGot = {}
		ev.OnClientEvent:Connect(function(data) table.insert(clientGot, data) end)
		ev:FireClient(lp, { available = {} })
		ev:FireAllClients("all")
		expect(#clientGot).toBe(2)
		expect(clientGot[2]).toBe("all")
		expect(function() fn:InvokeServer("o1") end).toThrow("OnServerInvoke is not set")
		fn.OnServerInvoke = function(player, orderId) return { ok = true, who = player.Name, id = orderId } end
		local result = fn:InvokeServer("o1")
		expect(result).toEqual({ ok = true, who = lp.Name, id = "o1" })
		expect(#shim.remoteLog).toBe(4) -- the failed InvokeServer is not logged
		expect(function() ev:FireClient("notaplayer") end).toThrow("expects a Player")
		local be = Instance.new("BindableEvent")
		local got
		be.Event:Connect(function(x) got = x end)
		be:Fire(5)
		expect(got).toBe(5)
		local bf = Instance.new("BindableFunction")
		bf.OnInvoke = function(a, b) return a + b end
		expect(bf:Invoke(2, 3)).toBe(5)
	end)
end)

describe("TweenService, Debris, Sound, ContextActionService", function()
	it("tweens interpolate on the virtual clock and fire Completed", function()
		local TweenService = game:GetService("TweenService")
		local part = Instance.new("Part")
		part.Transparency = 0
		part.CFrame = CFrame.new(0, 0, 0)
		local tween = TweenService:Create(part, TweenInfo.new(2, Enum.EasingStyle.Linear), { Transparency = 1, CFrame = CFrame.new(10, 0, 0), Size = v3(2, 2, 2) })
		local completed = {}
		tween.Completed:Connect(function(state) table.insert(completed, state) end)
		expect(tween.PlaybackState).toBe(Enum.PlaybackState.Begin)
		tween:Play()
		expect(tween.PlaybackState).toBe(Enum.PlaybackState.Playing)
		shim.advance(1)
		expect(part.Transparency).toBeCloseTo(0.5)
		expect(part.Position).toBeCloseTo(v3(5, 0, 0))
		shim.advance(1.5)
		expect(part.Transparency).toBe(1)
		expect(part.Size).toEqual(v3(2, 2, 2))
		expect(completed).toEqual({ Enum.PlaybackState.Completed })
		expect(tween.PlaybackState).toBe(Enum.PlaybackState.Completed)
		-- cancel
		local t2 = TweenService:Create(part, TweenInfo.new(1), { Transparency = 0 })
		local c2
		t2.Completed:Connect(function(s) c2 = s end)
		t2:Play()
		shim.advance(0.2)
		t2:Cancel()
		expect(c2).toBe(Enum.PlaybackState.Cancelled)
		expect(part.Transparency).toBeLessThan(1)
		-- instant mode
		shim.tweensInstant = true
		local t3 = TweenService:Create(part, TweenInfo.new(5), { Transparency = 0.25 })
		local c3
		t3.Completed:Connect(function(s) c3 = s end)
		t3:Play()
		expect(part.Transparency).toBe(0.25)
		shim.advance(0)
		expect(c3).toBe(Enum.PlaybackState.Completed)
		expect(TweenService:GetValue(0.5, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)).toBe(0.5)
	end)

	it("Debris destroys on schedule and Sounds track playback", function()
		local Debris = game:GetService("Debris")
		local part = Instance.new("Part", workspace)
		Debris:AddItem(part, 2)
		shim.advance(1.5)
		expect(part.Parent).toBe(workspace)
		shim.advance(0.6)
		expect(part.Parent).toBeNil()
		local sound = Instance.new("Sound")
		local played = 0
		sound.Played:Connect(function() played += 1 end)
		sound:Play()
		expect(sound.IsPlaying).toBe(true)
		expect(played).toBe(1)
		sound:Stop()
		expect(sound.IsPlaying).toBe(false)
		game:GetService("SoundService"):PlayLocalSound(sound)
		expect(sound.Playing).toBe(true)
		local emitter = Instance.new("ParticleEmitter")
		emitter:Emit(5)
	end)

	it("ContextActionService binds actions and shim.input dispatches keys", function()
		local CAS = game:GetService("ContextActionService")
		local log = {}
		CAS:BindAction("Brake", function(name, state, io)
			table.insert(log, name .. ":" .. state.Name .. ":" .. io.KeyCode.Name)
		end, true, Enum.KeyCode.Space, Enum.KeyCode.ButtonL2)
		CAS:SetTitle("Brake", "Brake")
		CAS:SetPosition("Brake", UDim2.new(0.5, 0, 0.5, 0))
		expect(CAS:GetButton("Brake")).toBeA("ImageButton")
		expect(CAS:GetButton("Brake")).toBe(CAS:GetButton("Brake"))
		shim.triggerAction("Brake", Enum.UserInputState.Begin)
		expect(log).toEqual({ "Brake:Begin:Space" })
		shim.input.press(Enum.KeyCode.ButtonL2, Enum.UserInputType.Gamepad1)
		shim.input.release(Enum.KeyCode.ButtonL2, Enum.UserInputType.Gamepad1)
		expect(log[2]).toBe("Brake:Begin:ButtonL2")
		expect(log[3]).toBe("Brake:End:ButtonL2")
		local UIS = game:GetService("UserInputService")
		local began = {}
		UIS.InputBegan:Connect(function(io, processed) table.insert(began, { io.KeyCode, processed }) end)
		shim.input.press(Enum.KeyCode.E)
		expect(began[1][1]).toBe(Enum.KeyCode.E)
		expect(began[1][2]).toBe(false)
		expect(UIS:IsKeyDown(Enum.KeyCode.E)).toBe(true)
		expect(UIS:GetLastInputType()).toBe(Enum.UserInputType.Keyboard)
		shim.input.release(Enum.KeyCode.E)
		expect(UIS:IsKeyDown(Enum.KeyCode.E)).toBe(false)
		CAS:UnbindAction("Brake")
		expect(function() shim.triggerAction("Brake") end).toThrow("no action named")
		expect(CAS:GetButton("Brake")).toBeNil()
	end)

	it("UI instances compute absolute sizes and text bounds", function()
		local gui = Instance.new("ScreenGui")
		gui.IgnoreGuiInset = true
		local frame = Instance.new("Frame", gui)
		frame.Size = UDim2.new(0.5, 0, 0, 100)
		frame.Position = UDim2.new(0.25, 10, 0, 0)
		expect(frame.AbsoluteSize).toEqual(Vector2.new(640, 100))
		expect(frame.AbsolutePosition).toEqual(Vector2.new(330, 0))
		local label = Instance.new("TextLabel", frame)
		label.Text = "Hello"
		label.TextSize = 20
		expect(label.TextBounds.Y).toBe(20)
		expect(label.TextBounds.X).toBeGreaterThan(0)
		local clicks = 0
		local button = Instance.new("TextButton", frame)
		button.MouseButton1Click:Connect(function() clicks += 1 end)
		button.Activated:Connect(function() clicks += 10 end)
		button.MouseButton1Click:Fire()
		button.Activated:Fire()
		expect(clicks).toBe(11)
		expect(game:GetService("TextService"):GetTextSize("abc", 14, Enum.Font.SourceSans, Vector2.new(1000, 100)).Y).toBe(14)
	end)
end)


--!strict
-- MeshAssets: Roblox asset ids of the imported vehicle meshes (assets/meshes/<VehicleId>/).
--
-- How to fill this in (one time, in Roblox Studio):
--   1. Import assets/meshes/<VehicleId>/<VehicleId>_Body.obj with the 3D Importer (one MeshPart per
--      OBJ, texture included). Studio uploads the mesh and its texture and gives you a MeshPart.
--   2. Select the MeshPart. In Properties, MeshId reads "rbxassetid://123456789" and TextureID
--      reads "rbxassetid://987654321". Paste the NUMBERS (not the whole string) below:
--        Van = { body = { meshId = 123456789, textureId = 987654321 }, wheels = {} }
--   3. A meshId of 0 means "not configured": the builder keeps the generated block parts for that
--      vehicle. textureId 0 leaves the mesh untextured (vertex colours / default grey).
--   4. Wheels are optional and may be added later without code changes. The key is the wheel name
--      from VehicleDefinitions[id].mesh.wheels (e.g. "FrontWheel"):
--        wheels = { FrontWheel = { meshId = 111, textureId = 222 }, RearWheel = { ... } }
--      Until a wheel is configured, no wheel part is created for it (the wheels are baked into the
--      body mesh).
--
-- The server creates the MeshParts from these ids (AssetService:CreateMeshPartAsync); the client
-- only ever clones the display copies the server publishes under
-- ReplicatedStorage.SharedAssets.VehicleDisplays. Geometry (size, offsets) lives in
-- VehicleDefinitions[id].mesh and comes from assets/meshes/<VehicleId>/meta.json.
--
-- EMBEDDED MODE (the active mode; docs/MESHES.md "Embedded mode (no upload)"): with
-- `embedded = true` and a data module under ReplicatedStorage.Shared.MeshData.<VehicleId>
-- (generated by tools/mesh_embed.py), no upload is needed at all. The server builds an invisible
-- placeholder Part "MeshBody" (tag "EmbeddedMeshBody") and every client rebuilds the mesh from the
-- embedded geometry/texture with EditableMesh/EditableImage (EmbeddedMeshController) and attaches
-- it to the placeholder. `isEmbedded(id)` reports that mode; it wins over uploaded ids. Set
-- `embedded = false` to use the uploaded-id path above instead.

local MeshAssets = {}

export type AssetIds = { meshId: number, textureId: number }
export type VehicleMeshAssets = { body: AssetIds, wheels: { [string]: AssetIds }, embedded: boolean? }

MeshAssets.ASSET_PREFIX = "rbxassetid://"

MeshAssets.Vehicles = {
	Bicycle = { body = { meshId = 0, textureId = 0 }, wheels = {}, embedded = true },
	Scooter = { body = { meshId = 0, textureId = 0 }, wheels = {}, embedded = true },
	Van = { body = { meshId = 0, textureId = 0 }, wheels = {}, embedded = true },
} :: { [string]: VehicleMeshAssets }

-- Name of the data module (ReplicatedStorage.Shared.MeshData) and of the placeholder tag.
MeshAssets.MESH_DATA_MODULE = "MeshData"
MeshAssets.EMBEDDED_TAG = "EmbeddedMeshBody"

-- The MeshData module, required lazily (it is large and optional): nil when absent or broken.
-- A test may inject a stub with MeshAssets._setMeshData(module) (nil restores lazy lookup).
local meshDataCache: any = nil
local meshDataOverride: any = nil
local function getMeshData(): any
	if meshDataOverride ~= nil then
		return meshDataOverride
	end
	if meshDataCache ~= nil then
		return meshDataCache
	end
	local ok, module = pcall(function()
		local shared = script.Parent and script.Parent.Parent
		local inst = shared and shared:FindFirstChild(MeshAssets.MESH_DATA_MODULE)
		if inst and inst:IsA("ModuleScript") then
			return (require :: any)(inst)
		end
		return nil
	end)
	if ok and type(module) == "table" and type(module.has) == "function" then
		meshDataCache = module
		return module
	end
	return nil
end

function MeshAssets._setMeshData(module: any)
	meshDataOverride = module
	meshDataCache = nil
end

local function validId(value: any): number
	if type(value) == "number" and value == value and value ~= math.huge and value > 0 then
		return math.floor(value)
	end
	return 0
end

-- True when a body mesh id is configured for the vehicle (the builder then uses the mesh path).
function MeshAssets.hasBody(vehicleId: string): boolean
	local entry = MeshAssets.Vehicles[vehicleId]
	return entry ~= nil and entry.body ~= nil and validId(entry.body.meshId) > 0
end

-- (meshId, textureId) of the body, or nil when not configured. textureId is 0 when untextured.
function MeshAssets.bodyIds(vehicleId: string): (number?, number?)
	local entry = MeshAssets.Vehicles[vehicleId]
	if not entry or not entry.body then
		return nil, nil
	end
	local meshId = validId(entry.body.meshId)
	if meshId <= 0 then
		return nil, nil
	end
	return meshId, validId(entry.body.textureId)
end

-- (meshId, textureId) of a named wheel, or nil when that wheel has no mesh configured.
function MeshAssets.wheelIds(vehicleId: string, wheelName: string): (number?, number?)
	local entry = MeshAssets.Vehicles[vehicleId]
	local wheel = entry and entry.wheels and entry.wheels[wheelName]
	if not wheel then
		return nil, nil
	end
	local meshId = validId(wheel.meshId)
	if meshId <= 0 then
		return nil, nil
	end
	return meshId, validId(wheel.textureId)
end

-- True when the vehicle uses the embedded data path: `embedded == true` in the table above and
-- the MeshData module reports data for the id. Never throws; a missing module means false.
function MeshAssets.isEmbedded(vehicleId: string): boolean
	local entry = MeshAssets.Vehicles[vehicleId]
	if not entry or entry.embedded ~= true then
		return false
	end
	local meshData = getMeshData()
	if not meshData then
		return false
	end
	local ok, has = pcall(meshData.has, vehicleId)
	return ok and has == true
end

-- True when the vehicle gets a custom (imported) body at all: embedded data or uploaded ids.
-- This is the client-side `useMesh` flag for VehicleDefinitions.getEffective.
function MeshAssets.usesCustomMesh(vehicleId: string): boolean
	return MeshAssets.hasBody(vehicleId) or MeshAssets.isEmbedded(vehicleId)
end

-- "rbxassetid://<id>" for a positive id, "" otherwise.
function MeshAssets.assetUrl(id: number?): string
	local n = validId(id)
	if n <= 0 then
		return ""
	end
	return MeshAssets.ASSET_PREFIX .. tostring(n)
end

return MeshAssets

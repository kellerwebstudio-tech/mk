		expect(decoded.list[3]).toBe(false)
		expect(decoded.list[4].deep).toBe("yes")
		expect(decoded.obj.a.b.c).toBe("d")
		expect(Http:JSONEncode({})).toBe("[]")
		expect(Http:JSONEncode({ 1, 2, 3 })).toBe("[1,2,3]")
		expect(Http:JSONEncode("a\"b\n")).toBe('"a\\"b\\n"')

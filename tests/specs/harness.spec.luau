	end)
end)

describe("Workspace raycast and queries", function()
	it("default raycast hits the y=0 ground plane going down", function()
		local hit = workspace:Raycast(v3(3, 10, 4), v3(0, -20, 0))
		expect(hit).never.toBeNil()
		expect(hit.Position).toBeCloseTo(v3(3, 0, 4))
		expect(hit.Normal).toEqual(v3(0, 1, 0))
		expect(hit.Distance).toBeCloseTo(10)
		expect(hit.Material).toBe(Enum.Material.Grass)
		expect(hit.Instance).toBe(workspace.Terrain)
		expect(workspace:Raycast(v3(0, 10, 0), v3(0, 5, 0))).toBeNil()
		expect(workspace:Raycast(v3(0, 10, 0), v3(0, -5, 0))).toBeNil() -- too short
		expect(workspace:Raycast(v3(0, -1, 0), v3(0, -5, 0))).toBeNil()
		local params = RaycastParams.new()
		params.FilterDescendantsInstances = { workspace.Terrain }
		params.FilterType = Enum.RaycastFilterType.Exclude
		expect(workspace:Raycast(v3(0, 10, 0), v3(0, -20, 0), params)).toBeNil()
		params.FilterType = Enum.RaycastFilterType.Include
		expect(workspace:Raycast(v3(0, 10, 0), v3(0, -20, 0), params)).never.toBeNil()
		params.FilterDescendantsInstances = {}
		expect(workspace:Raycast(v3(0, 10, 0), v3(0, -20, 0), params)).toBeNil()
	end)

	it("setRaycast overrides the default and reset restores it", function()
		local part = Instance.new("Part", workspace)
		shim.setRaycast(function(origin, dir, params)
			return { Position = origin + dir * 0.5, Normal = v3(0, 1, 0), Instance = part, Material = Enum.Material.Asphalt, Distance = dir.Magnitude * 0.5 }
		end)
		local hit = workspace:Raycast(v3(0, 10, 0), v3(0, 10, 0))
		expect(hit.Instance).toBe(part)
		expect(hit.Position).toEqual(v3(0, 15, 0))
		shim.setRaycast(nil)

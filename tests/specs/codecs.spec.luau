describe("Embedded data end-to-end", function()
	local Inflate, PngDecoder, MeshPack, MeshData, E

	-- PngDecoder progress thresholds by texture size: calls at exactly 0.5 (Adler-32 slices of
	-- 256 KB over the raw stream) and calls in (0.9, 1) (RGBA expansion, every ~64 KB of rows)
	local PROGRESS_MIN = {
		[1024] = { adlerSlices = 10, expandRows = 20 }, -- 3 MB raw stream, 4 MB RGBA
		[512] = { adlerSlices = 2, expandRows = 5 }, -- 0.75 MB raw stream, 1 MB RGBA
	}

	beforeEach(function()
		Inflate = requireShared("Util/Inflate")
		PngDecoder = requireShared("Util/PngDecoder")
		MeshPack = requireShared("MeshData/MeshPack")
		MeshData = requireShared("MeshData")
		E = vectors().embedded
	end)

	-- decodes one part blob through MeshPack and checks it against the index and the fixture
	local function checkPart(id, part, ep)
		local blob = MeshData.loadPart(id, part.name)
		expect(buffer.len(blob)).toBe(ep.bytes)
		expect(Inflate.adler32(blob)).toBe(ep.adler)
		local t0 = realClock()
		local mesh = MeshPack.decode(blob)
		local tMesh = realClock() - t0
		local label = id .. "." .. part.name
		expect(mesh.vertexCount).toBe(part.vertexCount)
		expect(mesh.triangleCount).toBe(part.triangleCount)
		expect(mesh.vertexCount).toBe(ep.vertexCount)
		expect(mesh.triangleCount).toBe(ep.triangleCount)
		expect(#mesh.positions).toBe(mesh.vertexCount)
		expect(#mesh.normals).toBe(mesh.vertexCount)
		expect(#mesh.uvs).toBe(mesh.vertexCount)
		expect(#mesh.triangles).toBe(mesh.triangleCount * 3)
		-- the blob header bbox is byte-exact with the fixture
		expect(mesh.bboxMin).toBeCloseTo(v3(ep.blobBboxMin), 1e-6)
		expect(mesh.bboxMax).toBeCloseTo(v3(ep.blobBboxMax), 1e-6)
		-- and, shifted by the pivot (legs are written relative to their hip), equals the index bbox
		-- in entry coordinates (the index rounds to 4 decimals)
		local pivot = if part.pivot then v3(part.pivot) else Vector3.zero
		expect(mesh.bboxMin + pivot).toBeCloseTo(v3(part.bboxMin), 1e-3)
		expect(mesh.bboxMax + pivot).toBeCloseTo(v3(part.bboxMax), 1e-3)
		local actualMin, actualMax = mesh.positions[1], mesh.positions[1]
		for i = 1, mesh.vertexCount do
			local p = mesh.positions[i]
			actualMin = actualMin:Min(p)
			actualMax = actualMax:Max(p)
			local uv = mesh.uvs[i]
			if uv.X < 0 or uv.X > 1 or uv.Y < 0 or uv.Y > 1 then
				error(string.format("%s: uv %d out of range (%s)", label, i, tostring(uv)))
			end
			local len = mesh.normals[i].Magnitude
			if math.abs(len - 1) > 0.02 then
				error(string.format("%s: normal %d has length %.4f", label, i, len))
			end
		end
		expect(actualMin).toBeCloseTo(mesh.bboxMin, 1e-4)
		expect(actualMax).toBeCloseTo(mesh.bboxMax, 1e-4)
		for i = 1, #mesh.triangles do
			local v = mesh.triangles[i]
			if v < 1 or v > mesh.vertexCount or v % 1 ~= 0 then
				error(string.format("%s: triangle index %d is %s", label, i, tostring(v)))
			end
		end
		if part.pivot then
			-- a leg blob is centred on the hip pivot: the centre of the decoded positions is the index
			-- bbox centre minus the pivot, so a MeshPart built from it (centred on its own bounds) sits
			-- at C1 = pivot - bboxCentre from the hip
			local decodedCentre = (actualMin + actualMax) / 2
			local indexCentre = (v3(part.bboxMin) + v3(part.bboxMax)) / 2
			expect(decodedCentre).toBeCloseTo(indexCentre - pivot, 1e-3)
			-- the hip (origin of the blob) is at the top of the leg (every leg face lies below the hip
			-- line, so the top is a little under it) and the foot reaches the ground
			expect(actualMax.Y).toBeLessThanOrEqual(1e-3)
			expect(actualMax.Y).toBeGreaterThanOrEqual(-0.3)
			expect(actualMin.Y).toBeCloseTo(-part.pivot[2], 0.05)
		else
			expect((actualMin + actualMax) / 2).toBeCloseTo((v3(part.bboxMin) + v3(part.bboxMax)) / 2, 1e-3)
		end
		return mesh, tMesh
	end

	for _, id in ipairs(ALL_IDS) do
		it("decodes the embedded " .. id .. " texture and every part blob", function()
			local expected = E[id]
			local index = MeshData.index(id)
			local lines = {}

			if expected.textured then
				-- texture: base64 chunks (one progress call each) -> PNG bytes -> RGBA
				local t0 = realClock()
				local png = loadWithProgress(MeshData, id, "texture", index.texture.chunks, index.texture.bytes)
				local tTexture = realClock() - t0
				expect(Inflate.adler32(png)).toBe(expected.textureAdler)

				local progressCalls = 0
				local adlerSliceCalls = 0 -- fraction exactly 0.5: inflate finished, Adler-32 slices in progress
				local expandCalls = 0 -- fraction in (0.9, 1): RGBA expansion rows
				local lastFraction = -1
				t0 = realClock()
				local image = PngDecoder.decode(png, {
					onProgress = function(fraction)
						progressCalls += 1
						expect(fraction).toBeGreaterThanOrEqual(lastFraction)
						lastFraction = fraction
						if fraction == 0.5 then
							adlerSliceCalls += 1
						elseif fraction > 0.9 and fraction < 1 then
							expandCalls += 1
						end
					end,
				})
				local tDecode = realClock() - t0
				expect(image.width).toBe(expected.width)
				expect(image.height).toBe(expected.height)
				expect(image.width).toBe(index.texture.width)
				expect(image.height).toBe(index.texture.height)
				expect(image.width == 1024 or image.width == 512).toBe(true)
				expect(image.height).toBe(image.width)
				expect(buffer.len(image.rgba)).toBe(image.width * image.height * 4)
				-- the zlib trailer check passed and matched the checksum Python computed for the stream
				expect(image.adler32).toBe(expected.idatAdler)
				-- and the pixels are exactly what PIL decodes
				expect(Inflate.adler32(image.rgba)).toBe(expected.rgbaAdler)
				expect(progressCalls).toBeGreaterThanOrEqual(10)
				expect(lastFraction).toBe(1)
				local minimum = PROGRESS_MIN[image.width]
				expect(adlerSliceCalls).toBeGreaterThanOrEqual(minimum.adlerSlices)
				expect(expandCalls).toBeGreaterThanOrEqual(minimum.expandRows)
				table.insert(lines, string.format("texture base64 %.0f ms, PNG decode %.0f ms (%dx%d)", tTexture * 1000, tDecode * 1000, image.width, image.height))
			else
				expect(index.texture).toBeNil()
				expect(MeshData.loadTexture(id)).toBeNil()
				table.insert(lines, "no texture")
			end

			-- geometry: every part through MeshPack
			expect(#index.parts).toBe(#expected.parts)
			for i, part in ipairs(index.parts) do
				local ep = expected.parts[i]
				expect(ep.name).toBe(part.name)
				local t0 = realClock()
				local mesh, tMesh = checkPart(id, part, ep)
				local tPart = realClock() - t0
				table.insert(lines, string.format("%s base64+DDCM %.0f ms (decode %.0f ms; %d verts, %d tris)", part.name, tPart * 1000, tMesh * 1000, mesh.vertexCount, mesh.triangleCount))
			end
			if index.kind == "figure" then
				expect(partNames(index.parts)).toEqual(FIGURE_PARTS)
			else
				expect(partNames(index.parts)).toEqual({ "Body" })
			end

			print(string.format("[codecs] %s (%s): %s", id, index.kind, table.concat(lines, "; ")))
		end)
	end
end)

--!nonstrict
-- Pure-Luau codecs: Util/Base64, Util/Inflate (zlib), Util/PngDecoder, MeshData/MeshPack and the
-- MeshData index (version 2), checked byte-exactly against tests/fixtures/CodecVectors.luau
-- (generated by tools/make_codec_fixtures.py), plus an end-to-end decode of the REAL embedded data
-- (vehicles, NPC figures, the courier vest: every texture and every part blob) with the decode
-- times printed (host wall clock).

local function requireShared(path)
	return shim.requirePath("ReplicatedStorage/Shared/" .. path)
end

local function vectors()
	return shim.requirePath("ReplicatedStorage/TestFixtures/CodecVectors")
end

local realClock = shim.realClock or os.clock

-- byte-exact buffer comparison with a useful failure message
local function expectBufferEquals(actual, expected, label)
	expect(type(actual)).toBe("buffer")
	local la, le = buffer.len(actual), buffer.len(expected)
	if la ~= le then
		error(string.format("%s: length %d, expected %d", label or "buffer", la, le), 2)
	end
	if buffer.tostring(actual) ~= buffer.tostring(expected) then
		for i = 0, la - 1 do
			local a, e = buffer.readu8(actual, i), buffer.readu8(expected, i)
			if a ~= e then
				error(string.format("%s: byte %d is %d, expected %d", label or "buffer", i, a, e), 2)
			end
		end
	end
end

local function bytes(s)
	return buffer.fromstring(s)
end


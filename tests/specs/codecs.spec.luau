describe("MeshPack", function()
	local Base64, MeshPack, D

	beforeEach(function()
		Base64 = requireShared("Util/Base64")
		MeshPack = requireShared("MeshData/MeshPack")
		D = vectors().ddcm
	end)

	it("decodes the DDCM cube built by tools/mesh_embed.py", function()
		local blob = Base64.decode(D.data)
		expect(buffer.len(blob)).toBe(D.length)
		local mesh = MeshPack.decode(blob)
		expect(mesh.vertexCount).toBe(D.vertexCount)
		expect(mesh.triangleCount).toBe(D.triangleCount)
		expect(mesh.vertexCount).toBe(24)
		expect(mesh.triangleCount).toBe(12)
		expect(#mesh.positions).toBe(24)
		expect(#mesh.normals).toBe(24)
		expect(#mesh.uvs).toBe(24)
		expect(#mesh.triangles).toBe(36)
		expect(mesh.bboxMin).toBeCloseTo(Vector3.new(D.bboxMin[1], D.bboxMin[2], D.bboxMin[3]), 1e-6)
		expect(mesh.bboxMax).toBeCloseTo(Vector3.new(D.bboxMax[1], D.bboxMax[2], D.bboxMax[3]), 1e-6)
		expect(mesh.bboxMin).toBeCloseTo(Vector3.new(-1, -1, -1), 1e-6)
		expect(mesh.bboxMax).toBeCloseTo(Vector3.new(1, 1, 1), 1e-6)
		for i = 1, 24 do
			local p, n, uv = D.positions[i], D.normalsRaw[i], D.uvsRaw[i]
			expect(mesh.positions[i]).toBeCloseTo(Vector3.new(p[1], p[2], p[3]), 1e-6)
			expect(mesh.normals[i]).toBeCloseTo(Vector3.new(n[1] / 127, n[2] / 127, n[3] / 127), 1e-6)
			expect(mesh.uvs[i]).toBeCloseTo(Vector2.new(uv[1] / 65535, uv[2] / 65535), 1e-6)
		end
		expect(mesh.triangles).toEqual(D.triangles)
		-- a few exact values: first face is the +Z quad (v1 v2 v3 / v1 v3 v4) with the OBJ's V flipped
		expect(mesh.positions[1]).toBeCloseTo(Vector3.new(-1, -1, 1), 1e-6)
		expect(mesh.normals[1]).toBeCloseTo(Vector3.new(0, 0, 1), 1e-6)
		expect(mesh.uvs[1]).toBeCloseTo(Vector2.new(0, 1), 1e-6) -- vt 0 0 -> (0, 1 - 0)
		expect(mesh.uvs[3]).toBeCloseTo(Vector2.new(1, 0), 1e-6) -- vt 1 1 -> (1, 0)
		expect(mesh.triangles[1]).toBe(1)
		expect(mesh.triangles[2]).toBe(2)
		expect(mesh.triangles[3]).toBe(3)
		expect(mesh.triangles[4]).toBe(1)
		expect(mesh.triangles[5]).toBe(3)
		expect(mesh.triangles[6]).toBe(4)
	end)

	it("errors on a bad magic, version or truncated blob", function()
		expect(function()
			MeshPack.decode(Base64.decode(D.badMagic))
		end).toThrow("bad magic")
		expect(function()
			MeshPack.decode(Base64.decode(D.badVersion))
		end).toThrow("version 2")
		expect(function()
			MeshPack.decode(Base64.decode(D.truncated))
		end).toThrow("truncated")
		expect(function()
			MeshPack.decode(buffer.create(10))
		end).toThrow("too short")
		expect(function()
			MeshPack.decode("DDCM")
		end).toThrow("expects a buffer")
	end)
end)


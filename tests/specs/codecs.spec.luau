local ALL_IDS = {
	"Bicycle",
	"CourierVest",
	"NPCCustomerA",
	"NPCCustomerB",
	"NPCDriver",
	"NPCPedestrianA",
	"NPCPedestrianB",
	"NPCPedestrianC",
	"NPCStaff",
	"NPCWorker",
	"Scooter",
	"Van",
}
local KIND_OF = {
	Bicycle = "vehicle",
	Scooter = "vehicle",
	Van = "vehicle",
	CourierVest = "accessory",
}
local FIGURE_PARTS = { "Body", "LegL", "LegR" }

local function v3(t)
	return Vector3.new(t[1], t[2], t[3])
end

local function partNames(parts)
	local names = {}
	for _, part in ipairs(parts) do
		table.insert(names, part.name)
	end
	return names
end

-- the fixture entry of one part (by name) of one embedded entry
local function fixturePart(E, id, name)
	for _, part in ipairs(E[id].parts) do
		if part.name == name then
			return part
		end
	end
	error(string.format("fixture has no part %s.%s", id, name))
end

-- loads one part / the texture through MeshData with an onProgress and checks one strictly increasing
-- call per chunk ending at the declared byte count; returns the buffer
local function loadWithProgress(MeshData, id, name, expectedChunks, expectedBytes)
	local calls = {}
	local options = {
		onProgress = function(done, total)
			table.insert(calls, { done, total })
		end,
	}
	local data = if name == "texture" then MeshData.loadTexture(id, options) else MeshData.loadPart(id, name, options)
	expect(type(data)).toBe("buffer")
	expect(#calls).toBe(expectedChunks)
	local last = 0
	for _, call in ipairs(calls) do
		expect(call[1]).toBeGreaterThan(last)
		expect(call[2]).toBe(expectedBytes)
		last = call[1]
	end
	expect(last).toBe(expectedBytes)
	expect(buffer.len(data)).toBe(expectedBytes)
	return data
end

describe("MeshData", function()
	local MeshData, Inflate, E

	beforeEach(function()
		MeshData = requireShared("MeshData")
		Inflate = requireShared("Util/Inflate")
		E = vectors().embedded
	end)

	it("lists the twelve entries with embedded data (sorted) and reports has() without throwing", function()
		expect(MeshData.VERSION).toBe(2)
		expect(MeshData.list()).toEqual(ALL_IDS)
		for _, id in ipairs(ALL_IDS) do
			expect(MeshData.has(id)).toBe(true)
			expect(E[id]).toBeDefined()
		end
		expect(MeshData.has("Truck")).toBe(false)
		expect(MeshData.has("MeshPack")).toBe(false)
		expect(MeshData.has("report")).toBe(false)
		expect(MeshData.has("Body_G1")).toBe(false)
		expect(MeshData.has(nil)).toBe(false)
		expect(MeshData.has(42)).toBe(false)
		expect(MeshData.has("")).toBe(false)
	end)

	it("returns the generated version-2 index tables that match the fixture", function()
		for _, id in ipairs(ALL_IDS) do
			local index = MeshData.index(id)
			local expected = E[id]
			expect(index.id).toBe(id)
			expect(index.version).toBe(2)
			expect(index.kind).toBe(expected.kind)
			expect(index.kind).toBe(KIND_OF[id] or "figure")
			expect(index.bboxMin).toEqual(expected.bboxMin)
			expect(index.bboxMax).toEqual(expected.bboxMax)
			if expected.textured then
				expect(index.texture.chunks).toBe(expected.textureChunks)
				expect(index.texture.bytes).toBe(expected.textureBytes)
				expect(index.texture.width).toBe(expected.width)
				expect(index.texture.height).toBe(expected.height)
				expect(index.texture.format).toBe("png")
			else
				expect(index.texture).toBeNil()
			end
			expect(#index.parts).toBe(#expected.parts)
			for i, part in ipairs(index.parts) do
				local ep = expected.parts[i]
				expect(part.name).toBe(ep.name)
				expect(#part.chunks).toBe(ep.chunks)
				for c, chunkName in ipairs(part.chunks) do
					expect(chunkName).toBe(string.format("%s_G%d", part.name, c))
				end
				expect(part.bytes).toBe(ep.bytes)
				expect(part.vertexCount).toBe(ep.vertexCount)
				expect(part.triangleCount).toBe(ep.triangleCount)
				expect(part.bboxMin).toEqual(ep.bboxMin)
				expect(part.bboxMax).toEqual(ep.bboxMax)
				if ep.pivot then
					expect(part.pivot).toEqual(ep.pivot)
				else
					expect(part.pivot).toBeNil()
				end
				-- the index bbox lies inside the entry's bbox
				for k = 1, 3 do
					expect(part.bboxMin[k]).toBeGreaterThanOrEqual(index.bboxMin[k] - 1e-3)
					expect(part.bboxMax[k]).toBeLessThanOrEqual(index.bboxMax[k] + 1e-3)
				end
			end
		end
	end)

	it("kind / parts / part describe vehicles, figures and the accessory", function()
		for _, id in ipairs({ "Bicycle", "Scooter", "Van" }) do
			expect(MeshData.kind(id)).toBe("vehicle")
			expect(partNames(MeshData.parts(id))).toEqual({ "Body" })
			expect(MeshData.index(id).texture.width).toBe(1024)
			expect(MeshData.part(id, "Body").pivot).toBeNil()
		end
		expect(MeshData.kind("CourierVest")).toBe("accessory")
		expect(partNames(MeshData.parts("CourierVest"))).toEqual({ "Body" })
		expect(MeshData.index("CourierVest").texture).toBeNil()
		-- the vest is centred on its origin, 2.3 x 1.9 x 1.3 studs
		local vest = MeshData.part("CourierVest", "Body")
		expect(v3(vest.bboxMin)).toBeCloseTo(Vector3.new(-1.15, -0.95, -0.65), 1e-3)
		expect(v3(vest.bboxMax)).toBeCloseTo(Vector3.new(1.15, 0.95, 0.65), 1e-3)
		for _, id in ipairs(ALL_IDS) do
			if not KIND_OF[id] then
				expect(MeshData.kind(id)).toBe("figure")
				local parts = MeshData.parts(id)
				expect(partNames(parts)).toEqual(FIGURE_PARTS)
				expect(parts).toBe(MeshData.index(id).parts)
				expect(MeshData.index(id).texture.width).toBe(512)
				-- figures stand on the ground between their feet, 5.2 studs tall, centred in x/z
				local index = MeshData.index(id)
				expect(index.bboxMin[2]).toBeCloseTo(0, 1e-3)
				expect(index.bboxMax[2]).toBeCloseTo(5.2, 1e-3)
				expect(index.bboxMin[1]).toBeCloseTo(-index.bboxMax[1], 1e-3)
				expect(index.bboxMin[3]).toBeCloseTo(-index.bboxMax[3], 1e-3)
				expect(MeshData.part(id, "Body").pivot).toBeNil()
				for _, leg in ipairs({ "LegL", "LegR" }) do
					local part = MeshData.part(id, leg)
					expect(part).toBe(parts[leg == "LegL" and 2 or 3])
					expect(part.pivot).toBeDefined()
					-- the hip pivot sits on the hip line, inside the leg's x/z extent
					expect(part.pivot[2]).toBeCloseTo(0.46 * 5.2, 1e-3)
					expect(part.pivot[1]).toBeGreaterThanOrEqual(part.bboxMin[1])
					expect(part.pivot[1]).toBeLessThanOrEqual(part.bboxMax[1])
					expect(part.pivot[3]).toBeGreaterThanOrEqual(part.bboxMin[3])
					expect(part.pivot[3]).toBeLessThanOrEqual(part.bboxMax[3])
					-- the legs reach the ground and stop at the hip
					expect(part.bboxMin[2]).toBeLessThan(0.05)
					expect(part.bboxMax[2]).toBeLessThanOrEqual(part.pivot[2] + 1e-3)
				end
				-- left leg on -x, right leg on +x
				expect(MeshData.part(id, "LegL").pivot[1]).toBeLessThan(0)
				expect(MeshData.part(id, "LegR").pivot[1]).toBeGreaterThan(0)
			end
			expect(MeshData.part(id, "Wheel")).toBeNil()
			expect(MeshData.part(id, "")).toBeNil()
		end
	end)

	it("errors on unknown entries, unknown parts and the wrong index version", function()
		for _, method in ipairs({ "index", "kind", "parts", "loadGeometry", "loadTexture" }) do
			expect(function()
				MeshData[method]("Truck")
			end).toThrow("no embedded data")
			expect(function()
				MeshData[method](nil)
			end).toThrow("no embedded data")
		end
		expect(function()
			MeshData.part("Truck", "Body")
		end).toThrow("no embedded data")
		expect(function()
			MeshData.loadPart("Truck", "Body")
		end).toThrow("no embedded data")
		expect(function()
			MeshData.loadPart("Van", "LegL")
		end).toThrow("no part")
		expect(function()
			MeshData.loadPart("NPCStaff", "Wheel")
		end).toThrow("no part")
		-- MeshPack is a child ModuleScript but not an index
		expect(function()
			MeshData.index("MeshPack")
		end).toThrow("no embedded data")
		-- a stale version-1 index is refused
		local stale = Instance.new("ModuleScript")
		stale.Name = "Stale"
		stale.Source = 'return { vehicleId = "Stale", version = 1, geometry = { chunks = 1, bytes = 0 }, texture = { chunks = 1, bytes = 0 } }'
		stale.Parent = shim.getInstance("ReplicatedStorage/Shared/MeshData")
		expect(MeshData.has("Stale")).toBe(false)
		expect(table.find(MeshData.list(), "Stale")).toBeNil()
		local v2 = Instance.new("ModuleScript")
		v2.Name = "Bad"
		v2.Source = 'return { id = "Bad", version = 1, kind = "vehicle", bboxMin = { 0, 0, 0 }, bboxMax = { 1, 1, 1 }, parts = { { name = "Body", chunks = { "Body_G1" }, bytes = 0 } } }'
		v2.Parent = shim.getInstance("ReplicatedStorage/Shared/MeshData")
		expect(MeshData.has("Bad")).toBe(false)
		expect(function()
			MeshData.index("Bad")
		end).toThrow("version 1, expected 2")
	end)

	it("loadPart decodes every part chunk by chunk, reports progress per chunk and matches the fixture", function()
		for _, id in ipairs(ALL_IDS) do
			for _, part in ipairs(MeshData.parts(id)) do
				local ep = fixturePart(E, id, part.name)
				local chunked = loadWithProgress(MeshData, id, part.name, #part.chunks, part.bytes)
				expect(Inflate.adler32(chunked)).toBe(ep.adler)
				-- byte-identical to the plain (no options) decode
				local plain = MeshData.loadPart(id, part.name)
				expect(buffer.len(plain)).toBe(part.bytes)
				expect(buffer.tostring(chunked) == buffer.tostring(plain)).toBe(true)
				expect(buffer.readstring(plain, 0, 4)).toBe("DDCM")
			end
		end
		-- multi-chunk parts exist (the vehicle bodies) so the chunked path is exercised
		expect(#MeshData.part("Van", "Body").chunks).toBeGreaterThanOrEqual(1)
		expect(#MeshData.part("Bicycle", "Body").chunks).toBe(2)
	end)

	it("loadGeometry is an alias of loadPart(id, \"Body\")", function()
		for _, id in ipairs({ "Van", "CourierVest", "NPCStaff" }) do
			local a = MeshData.loadGeometry(id)
			local b = MeshData.loadPart(id, "Body")
			expect(buffer.len(a)).toBe(E[id].parts[1].bytes)
			expect(buffer.tostring(a) == buffer.tostring(b)).toBe(true)
			local calls = 0
			local c = MeshData.loadGeometry(id, {
				onProgress = function()
					calls += 1
				end,
			})
			expect(calls).toBe(#MeshData.part(id, "Body").chunks)
			expect(buffer.tostring(c) == buffer.tostring(a)).toBe(true)
		end
	end)

	it("loadTexture decodes chunk by chunk with progress and returns nil for the untextured vest", function()
		expect(MeshData.loadTexture("CourierVest")).toBeNil()
		expect(MeshData.loadTexture("CourierVest", { onProgress = function() error("no chunks to report") end })).toBeNil()
		-- one 1024 px texture (11 chunks) and one 512 px texture (3 chunks)
		for _, id in ipairs({ "Bicycle", "NPCStaff" }) do
			local index = MeshData.index(id)
			local png = loadWithProgress(MeshData, id, "texture", index.texture.chunks, index.texture.bytes)
			expect(Inflate.adler32(png)).toBe(E[id].textureAdler)
			expect(buffer.readstring(png, 1, 3)).toBe("PNG")
		end
		expect(MeshData.index("Bicycle").texture.chunks).toBe(11)
		expect(MeshData.index("NPCStaff").texture.chunks).toBe(3)
	end)
end)


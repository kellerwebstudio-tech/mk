--!nonstrict
-- tests/specs/harness.spec.luau — proves the offline harness itself (shim + runner + bundler).

local function v3(x, y, z) return Vector3.new(x, y, z) end

describe("Vector3", function()
	it("supports arithmetic with numbers and vectors", function()
		local a, b = v3(1, 2, 3), v3(4, 5, 6)
		expect(a + b).toEqual(v3(5, 7, 9))
		expect(b - a).toEqual(v3(3, 3, 3))
		expect(a * 2).toEqual(v3(2, 4, 6))
		expect(2 * a).toEqual(v3(2, 4, 6))
		expect(a * b).toEqual(v3(4, 10, 18))
		expect(b / 2).toEqual(v3(2, 2.5, 3))
		expect(-a).toEqual(v3(-1, -2, -3))
		expect(a == v3(1, 2, 3)).toBe(true)
		expect(a ~= b).toBe(true)
	end)

	it("exposes Magnitude, Unit, Dot, Cross, Lerp and FuzzyEq", function()
		local a = v3(3, 4, 0)
		expect(a.Magnitude).toBe(5)
		expect(a.Unit).toBeCloseTo(v3(0.6, 0.8, 0))
		expect(v3(1, 0, 0):Dot(v3(0, 1, 0))).toBe(0)
		expect(v3(1, 0, 0):Cross(v3(0, 1, 0))).toEqual(v3(0, 0, 1))
		expect(v3(0, 0, 0):Lerp(v3(10, 10, 10), 0.25)).toEqual(v3(2.5, 2.5, 2.5))
		expect(v3(1, 1, 1):FuzzyEq(v3(1, 1, 1.000001), 1e-4)).toBe(true)
		expect(v3(-1, 2, -3):Abs()).toEqual(v3(1, 2, 3))
		expect(v3(1, 5, 3):Max(v3(2, 1, 9))).toEqual(v3(2, 5, 9))
		expect(v3(1, 5, 3):Min(v3(2, 1, 9))).toEqual(v3(1, 1, 3))
		expect(Vector3.zero).toEqual(v3(0, 0, 0))
		expect(Vector3.yAxis).toEqual(v3(0, 1, 0))
		expect(tostring(v3(1, 2.5, -3))).toBe("1, 2.5, -3")
	end)

	it("is immutable", function()
		local a = v3(1, 2, 3)
		expect(function() a.X = 5 end).toThrow("readonly")
		expect(function() CFrame.new().x = 5 end).toThrow("readonly")
	end)
end)

describe("CFrame", function()
	it("lookAt orients the LookVector toward the target", function()
		local cf = CFrame.lookAt(v3(0, 0, 0), v3(0, 0, -10))
		expect(cf.LookVector).toBeCloseTo(v3(0, 0, -1))
		expect(cf.RightVector).toBeCloseTo(v3(1, 0, 0))
		expect(cf.UpVector).toBeCloseTo(v3(0, 1, 0))
		local cf2 = CFrame.lookAt(v3(5, 0, 5), v3(15, 0, 5))
		expect(cf2.LookVector).toBeCloseTo(v3(1, 0, 0))
		expect(cf2.RightVector).toBeCloseTo(v3(0, 0, 1))
		expect(cf2.Position).toEqual(v3(5, 0, 5))
		-- legacy CFrame.new(pos, lookAt) form
		expect(CFrame.new(v3(0, 0, 0), v3(0, 0, -1)):FuzzyEq(CFrame.identity)).toBe(true)
		-- looking straight down does not produce NaNs
		local down = CFrame.lookAt(v3(0, 10, 0), v3(0, 0, 0))
		expect(down.LookVector).toBeCloseTo(v3(0, -1, 0))
		expect(down.RightVector.Magnitude).toBeCloseTo(1)
	end)

	it("inverse round-trips and composes with real matrices", function()
		local cf = CFrame.new(1, 2, 3) * CFrame.Angles(0.3, -1.2, 0.7)
		expect((cf * cf:Inverse()):FuzzyEq(CFrame.identity, 1e-6)).toBe(true)
		expect((cf:Inverse() * cf):FuzzyEq(CFrame.identity, 1e-6)).toBe(true)
		local a = CFrame.Angles(0, math.pi / 2, 0)
		local b = CFrame.new(10, 0, 0)
		expect((a * b).Position).toBeCloseTo(v3(0, 0, -10))
		expect((b * a).Position).toBeCloseTo(v3(10, 0, 0))
	end)

	it("transforms points and vectors between spaces", function()
		local cf = CFrame.new(1, 2, 3) * CFrame.Angles(0, math.pi / 2, 0)
		local world = cf:PointToWorldSpace(v3(1, 0, 0))
		expect(world).toBeCloseTo(v3(1, 2, 2))
		expect(cf * v3(1, 0, 0)).toBeCloseTo(v3(1, 2, 2))
		expect(cf:PointToObjectSpace(world)).toBeCloseTo(v3(1, 0, 0))
		expect(cf:VectorToWorldSpace(v3(1, 0, 0))).toBeCloseTo(v3(0, 0, -1))
		expect(cf:VectorToObjectSpace(v3(0, 0, -1))).toBeCloseTo(v3(1, 0, 0))
		local other = CFrame.new(5, 5, 5)
		expect(cf:ToObjectSpace(cf:ToWorldSpace(other)):FuzzyEq(other, 1e-6)).toBe(true)
		expect((cf + v3(1, 1, 1)).Position).toEqual(v3(2, 3, 4))
		expect((cf - v3(1, 1, 1)).Position).toEqual(v3(0, 1, 2))
	end)

	it("round-trips Euler angles, orientation, axis-angle and quaternions", function()
		local rx, ry, rz = 0.4, -0.9, 1.3
		local a = CFrame.Angles(rx, ry, rz)
		local x, y, z = a:ToEulerAnglesXYZ()
		expect(x).toBeCloseTo(rx)
		expect(y).toBeCloseTo(ry)
		expect(z).toBeCloseTo(rz)
		local o = CFrame.fromOrientation(rx, ry, rz)
		local ox, oy, oz = o:ToOrientation()
		expect(ox).toBeCloseTo(rx)
		expect(oy).toBeCloseTo(ry)
		expect(oz).toBeCloseTo(rz)
		expect(CFrame.Angles(0, 0.5, 0):FuzzyEq(CFrame.fromAxisAngle(v3(0, 1, 0), 0.5), 1e-6)).toBe(true)
		local axis, angle = CFrame.fromAxisAngle(v3(0, 0, 1), 1.1):ToAxisAngle()
		expect(axis).toBeCloseTo(v3(0, 0, 1))
		expect(angle).toBeCloseTo(1.1)
		local comps = { a:GetComponents() }
		expect(#comps).toBe(12)
		expect(CFrame.new(unpack(comps)):FuzzyEq(a, 1e-9)).toBe(true)
		-- Angles(x,y,z) == Angles(x,0,0)*Angles(0,y,0)*Angles(0,0,z)
		expect((CFrame.Angles(rx, 0, 0) * CFrame.Angles(0, ry, 0) * CFrame.Angles(0, 0, rz)):FuzzyEq(a, 1e-6)).toBe(true)
		-- fromMatrix
		local m = CFrame.fromMatrix(v3(1, 1, 1), a.RightVector, a.UpVector)
		expect(m:FuzzyEq(CFrame.new(1, 1, 1) * a, 1e-6)).toBe(true)
		-- Orthonormalize keeps a valid rotation
		local on = m:Orthonormalize()
		expect(on.RightVector:Dot(on.UpVector)).toBeCloseTo(0, 1e-6)
	end)

	it("Lerp interpolates rotation and position", function()
		local a = CFrame.new(0, 0, 0)
		local b = CFrame.new(10, 0, 0) * CFrame.Angles(0, math.pi / 2, 0)
		local mid = a:Lerp(b, 0.5)
		expect(mid.Position).toBeCloseTo(v3(5, 0, 0))
		local _, y, _ = mid:ToEulerAnglesXYZ()
		expect(y).toBeCloseTo(math.pi / 4)
		expect(a:Lerp(b, 1):FuzzyEq(b, 1e-6)).toBe(true)
	end)
end)

describe("Color3, UDim2, NumberRange, Random", function()
	it("Color3 conversions round-trip", function()
		local c = Color3.fromRGB(255, 128, 0)
		expect(c.R).toBe(1)
		expect(c.G).toBeCloseTo(128 / 255)
		local h, s, v = c:ToHSV()
		expect(Color3.fromHSV(h, s, v)).toBeCloseTo(c, 1e-6)
		expect(Color3.fromHex("#FF8000")).toBeCloseTo(c, 1e-6)
		expect(c:ToHex()).toBe("ff8000")
		expect(Color3.new(0, 0, 0):Lerp(Color3.new(1, 1, 1), 0.5)).toBeCloseTo(Color3.new(0.5, 0.5, 0.5))
		expect(BrickColor.new("Bright red").Color).toBeCloseTo(Color3.fromRGB(196, 40, 28))
	end)

	it("UDim2 arithmetic and constructors", function()
		local a = UDim2.new(0.5, 10, 0, 20)
		local b = UDim2.fromScale(0.25, 0.25) + UDim2.fromOffset(5, 5)
		expect(a.X.Scale).toBe(0.5)
		expect(a.X.Offset).toBe(10)
		expect((a + b).X.Scale).toBe(0.75)
		expect((a - b).Y.Offset).toBe(15)
		expect(a == UDim2.new(0.5, 10, 0, 20)).toBe(true)
		expect(NumberRange.new(1, 5).Max).toBe(5)
		expect(NumberRange.new(3).Min).toBe(3)
		expect(#NumberSequence.new(0, 1).Keypoints).toBe(2)
		expect(TweenInfo.new(2).EasingStyle).toBe(Enum.EasingStyle.Quad)
	end)

	it("Random is deterministic per seed", function()
		local r1, r2 = Random.new(7), Random.new(7)
		for _ = 1, 20 do
			local i = r1:NextInteger(1, 6)
			expect(i).toBe(r2:NextInteger(1, 6))
			expect(i).toBeGreaterThanOrEqual(1)
			expect(i).toBeLessThanOrEqual(6)
		end
		local n = r1:NextNumber()
		expect(n).toBeGreaterThanOrEqual(0)
		expect(n).toBeLessThan(1)
		expect(r1:NextUnitVector().Magnitude).toBeCloseTo(1)
		local t = { 1, 2, 3, 4, 5 }
		r1:Shuffle(t)
		table.sort(t)
		expect(t).toEqual({ 1, 2, 3, 4, 5 })
		expect(Random.new(1):NextNumber() == Random.new(2):NextNumber()).toBe(false)
	end)
end)

describe("typeof and Enum", function()
	it("typeof reports Roblox type names", function()
		expect(typeof(v3(0, 0, 0))).toBe("Vector3")
		expect(typeof(Vector2.new())).toBe("Vector2")
		expect(typeof(CFrame.new())).toBe("CFrame")
		expect(typeof(Color3.new())).toBe("Color3")
		expect(typeof(Instance.new("Part"))).toBe("Instance")
		expect(typeof(Enum.Material.Plastic)).toBe("EnumItem")
		expect(typeof(Enum.Material)).toBe("Enum")
		expect(typeof(Enum)).toBe("Enums")
		expect(typeof(Random.new())).toBe("Random")
		expect(typeof(Instance.new("Part").Touched)).toBe("RBXScriptSignal")
		expect(typeof(UDim2.new())).toBe("UDim2")
		expect(typeof(TweenInfo.new())).toBe("TweenInfo")
		expect(typeof(RaycastParams.new())).toBe("RaycastParams")
		expect(typeof(DateTime.now())).toBe("DateTime")
		expect(typeof({})).toBe("table")
		expect(typeof(5)).toBe("number")
		expect(typeof(nil)).toBe("nil")
		expect(typeof("s")).toBe("string")
	end)

	it("Enum items are stable identities with Name/Value/EnumType", function()
		expect(Enum.Material.Plastic).toBe(Enum.Material.Plastic)
		expect(Enum.Material.Plastic == Enum.Material.Wood).toBe(false)
		expect(Enum.Material.Plastic.Name).toBe("Plastic")
		expect(Enum.Material.Plastic.Value).toBe(256)
		expect(Enum.Material.Plastic.EnumType).toBe(Enum.Material)
		expect(Enum.PartType.Ball.Value).toBe(0)
		expect(Enum.KeyCode.E.Value).toBe(101)
		expect(Enum.HumanoidStateType.Seated.Name).toBe("Seated")
		expect(tostring(Enum.EasingStyle.Linear)).toBe("Enum.EasingStyle.Linear")
		expect(Enum.NormalId:GetEnumItems()).toContain(Enum.NormalId.Top)
		expect(#Enum.NormalId:GetEnumItems()).toBe(6)
		expect(Enum.RaycastFilterType.Exclude.Value).toBe(0)
		expect(Enum.RaycastFilterType.Include.Value).toBe(1)
		expect(Enum.ContextActionPriority.High.Value).toBe(3000)
		-- lazily created enums behave the same way
		expect(Enum.SomeFutureEnum.SomeItem).toBe(Enum.SomeFutureEnum.SomeItem)
		expect(Enum.SomeFutureEnum.SomeItem.EnumType.Name).toBe("SomeFutureEnum")
	end)
end)

describe("Instance basics", function()
	it("Instance.new gives class defaults and a property bag", function()
		local p = Instance.new("Part")
		expect(p.ClassName).toBe("Part")
		expect(p.Name).toBe("Part")
		expect(p.Size).toEqual(v3(4, 1, 2))
		expect(p.CFrame).toEqual(CFrame.identity)
		expect(p.Anchored).toBe(false)
		expect(p.CanCollide).toBe(true)
		expect(p.Transparency).toBe(0)
		expect(p.Material).toBe(Enum.Material.Plastic)
		expect(p.CollisionGroup).toBe("Default")
		expect(p.AssemblyLinearVelocity).toEqual(Vector3.zero)
		expect(p.Parent).toBeNil()
		expect(p.UnknownProperty).toBeNil()
		p.UnknownProperty = 7
		expect(p.UnknownProperty).toBe(7)
		expect(p:GetMass()).toBeCloseTo(4 * 1 * 2 * 0.7)
		expect(p.AssemblyMass).toBeCloseTo(5.6)
		p.Massless = true
		expect(p.AssemblyMass).toBe(0)
		expect(Instance.new("Humanoid").Health).toBe(100)
		expect(Instance.new("Seat").Occupant).toBeNil()
		expect(Instance.new("Frame").Size).toEqual(UDim2.new(0, 100, 0, 100))
	end)

	it("Position/Orientation derive from CFrame and are settable", function()
		local p = Instance.new("Part")
		p.CFrame = CFrame.new(1, 2, 3) * CFrame.fromOrientation(0, math.rad(90), 0)
		expect(p.Position).toBeCloseTo(v3(1, 2, 3))
		expect(p.Orientation).toBeCloseTo(v3(0, 90, 0), 1e-4)
		p.Position = v3(5, 5, 5)
		expect(p.CFrame.Position).toEqual(v3(5, 5, 5))
		expect(p.Orientation).toBeCloseTo(v3(0, 90, 0), 1e-4)
		p.Orientation = v3(0, 0, 45)
		expect(p.CFrame.Position).toEqual(v3(5, 5, 5))
		expect(p.Orientation).toBeCloseTo(v3(0, 0, 45), 1e-4)
		local hits = 0
		p:GetPropertyChangedSignal("Position"):Connect(function() hits += 1 end)
		p.CFrame = CFrame.new(9, 9, 9)
		expect(hits).toBe(1)
	end)

	it("parenting maintains child lists and fires ChildAdded/ChildRemoved/AncestryChanged", function()
		local folder = Instance.new("Folder")
		local part = Instance.new("Part")
		local added, removed, ancestry = {}, {}, {}
		folder.ChildAdded:Connect(function(c) table.insert(added, c) end)
		folder.ChildRemoved:Connect(function(c) table.insert(removed, c) end)
		part.AncestryChanged:Connect(function(child, parent) table.insert(ancestry, { child, parent }) end)
		part.Parent = folder
		expect(part.Parent).toBe(folder)
		expect(folder:GetChildren()).toEqual({ part })
		expect(folder.Part).toBe(part)
		expect(folder:FindFirstChild("Part")).toBe(part)
		expect(folder:FindFirstChildOfClass("Part")).toBe(part)
		expect(folder:FindFirstChildWhichIsA("BasePart")).toBe(part)
		expect(#added).toBe(1)
		expect(ancestry[1][1]).toBe(part)
		expect(ancestry[1][2]).toBe(folder)
		part.Parent = nil
		expect(#removed).toBe(1)
		expect(#folder:GetChildren()).toBe(0)
		expect(#ancestry).toBe(2)
		expect(part:GetFullName()).toBe("Part")
		part.Parent = workspace
		expect(part:GetFullName()).toBe("Workspace.Part")
		expect(part:IsDescendantOf(game)).toBe(true)
		expect(workspace:IsAncestorOf(part)).toBe(true)
		expect(function() part.Parent = part end).toThrow("own parent")
		expect(function() folder.Parent = 5 end).toThrow("Instance or nil")
	end)

	it("Instance.new accepts a parent and DescendantAdded fires up the chain", function()
		local seen = {}
		workspace.DescendantAdded:Connect(function(d) table.insert(seen, d) end)
		local model = Instance.new("Model", workspace)
		local part = Instance.new("Part", model)
		expect(seen).toEqual({ model, part })
		expect(workspace:FindFirstChild("Part", true)).toBe(part)
		expect(workspace:FindFirstChild("Part")).toBeNil()
		expect(part:FindFirstAncestorOfClass("Workspace")).toBe(workspace)
		expect(part:FindFirstAncestorWhichIsA("Model")).toBe(model)
		expect(part:FindFirstAncestor("Model")).toBe(model)
		expect(workspace:GetDescendants()).toContain(part)
	end)

	it("IsA follows the class hierarchy", function()
		local seat = Instance.new("VehicleSeat")
		expect(seat:IsA("VehicleSeat")).toBe(true)
		expect(seat:IsA("BasePart")).toBe(true)
		expect(seat:IsA("PVInstance")).toBe(true)
		expect(seat:IsA("Instance")).toBe(true)
		expect(seat:IsA("Model")).toBe(false)
		expect(Instance.new("Seat"):IsA("Part")).toBe(true)
		expect(Instance.new("MeshPart"):IsA("BasePart")).toBe(true)
		expect(Instance.new("Model"):IsA("PVInstance")).toBe(true)
		expect(Instance.new("TextButton"):IsA("GuiButton")).toBe(true)
		expect(Instance.new("TextButton"):IsA("GuiObject")).toBe(true)
		expect(Instance.new("ScreenGui"):IsA("LayerCollector")).toBe(true)
		expect(Instance.new("ScreenGui"):IsA("GuiBase2d")).toBe(true)
		expect(Instance.new("LocalScript"):IsA("LuaSourceContainer")).toBe(true)
		expect(Instance.new("ModuleScript"):IsA("BaseScript")).toBe(false)
		expect(Instance.new("AlignOrientation"):IsA("Constraint")).toBe(true)
		expect(Instance.new("Motor6D"):IsA("JointInstance")).toBe(true)
		expect(Instance.new("IntValue"):IsA("ValueBase")).toBe(true)
		expect(workspace:IsA("Model")).toBe(true)
		expect(workspace.Terrain:IsA("BasePart")).toBe(true)
		expect(game:IsA("DataModel")).toBe(true)
	end)

	it("Destroy fires Destroying, removes from parent and locks Parent", function()
		local part = Instance.new("Part", workspace)
		local child = Instance.new("Attachment", part)
		local destroying = 0
		part.Destroying:Connect(function() destroying += 1 end)
		local childDestroying = 0
		child.Destroying:Connect(function() childDestroying += 1 end)
		part:Destroy()
		expect(destroying).toBe(1)
		expect(childDestroying).toBe(1)
		expect(part.Parent).toBeNil()
		expect(workspace:FindFirstChild("Part")).toBeNil()
		expect(function() part.Parent = workspace end).toThrow("locked")
		part:Destroy() -- idempotent
	end)

	it("Clone deep-copies properties, attributes, tags and children", function()
		local model = Instance.new("Model")
		model.Name = "Vehicle"
		model:SetAttribute("VehicleId", "Bicycle")
		model:AddTag("DeliveryVehicle")
		local part = Instance.new("Part", model)
		part.Name = "Chassis"
		part.Size = v3(1, 2, 3)
		part.Color = Color3.new(1, 0, 0)
		model.PrimaryPart = part
		local copy = model:Clone()
		expect(copy).never.toBe(model)
		expect(copy.Name).toBe("Vehicle")
		expect(copy:GetAttribute("VehicleId")).toBe("Bicycle")
		expect(copy:HasTag("DeliveryVehicle")).toBe(true)
		expect(copy.Chassis).never.toBe(part)
		expect(copy.Chassis.Size).toEqual(v3(1, 2, 3))
		expect(copy.Chassis.Color).toEqual(Color3.new(1, 0, 0))
		expect(copy.Parent).toBeNil()
		part.Archivable = false
		expect(part:Clone()).toBeNil()
	end)

	it("attributes and tags fire their signals", function()
		local p = Instance.new("Part")
		local attrChanged, named = {}, 0
		p.AttributeChanged:Connect(function(name) table.insert(attrChanged, name) end)
		p:GetAttributeChangedSignal("Speed"):Connect(function() named += 1 end)
		p:SetAttribute("Speed", 10)
		p:SetAttribute("Speed", 10) -- unchanged: no signal
		p:SetAttribute("Speed", 12)
		p:SetAttribute("Label", "x")
		expect(p:GetAttribute("Speed")).toBe(12)
		expect(attrChanged).toEqual({ "Speed", "Speed", "Label" })
		expect(named).toBe(2)
		expect(p:GetAttributes()).toEqual({ Speed = 12, Label = "x" })
		expect(function() p:SetAttribute("Bad", {}) end).toThrow()
		p:AddTag("A")
		p:AddTag("B")
		expect(p:GetTags()).toEqual({ "A", "B" })
		p:RemoveTag("A")
		expect(p:HasTag("A")).toBe(false)
		expect(p:HasTag("B")).toBe(true)
	end)

	it("Changed and GetPropertyChangedSignal fire only on real changes", function()
		local p = Instance.new("Part")
		local changed, sizeChanges = {}, 0
		p.Changed:Connect(function(prop) table.insert(changed, prop) end)
		p:GetPropertyChangedSignal("Size"):Connect(function() sizeChanges += 1 end)
		p.Size = v3(1, 1, 1)
		p.Size = v3(1, 1, 1)
		p.Name = "Renamed"
		p.Anchored = true
		expect(sizeChanges).toBe(1)
		expect(changed).toEqual({ "Size", "Name", "Anchored" })
		local iv = Instance.new("IntValue")
		local values = {}
		iv.Changed:Connect(function(v) table.insert(values, v) end)
		iv.Value = 3.7
		expect(iv.Value).toBe(3)
		expect(values).toEqual({ 3 })
	end)

	it("errors clearly for methods that belong to another class", function()
		local p = Instance.new("Part")
		expect(function() return p:GetBoundingBox() end).toThrow("GetBoundingBox is not a valid member of Part")
		expect(function() return p:Sit() end).toThrow("Sit is not a valid member of Part")
		expect(function() p.ClassName = "Model" end).toThrow("read only")
	end)
end)

describe("WaitForChild and the virtual scheduler", function()
	it("WaitForChild returns immediately when the child exists", function()
		local f = Instance.new("Folder")
		local c = Instance.new("Part", f)
		c.Name = "Chassis"
		expect(f:WaitForChild("Chassis")).toBe(c)
	end)

	it("WaitForChild yields across shim.advance until the child is added", function()
		local f = Instance.new("Folder", workspace)
		local result, finished = nil, false
		task.spawn(function()
			result = f:WaitForChild("Later")
			finished = true
		end)
		shim.advance(1)
		expect(finished).toBe(false)
		local later = Instance.new("Part")
		later.Name = "Later"
		later.Parent = f
		expect(finished).toBe(false) -- resumes on the next step like the engine
		shim.advance(0)
		expect(finished).toBe(true)
		expect(result).toBe(later)
	end)

	it("WaitForChild times out with nil and no warnings", function()
		local f = Instance.new("Folder")
		local result, finished = "unset", false
		task.spawn(function()
			result = f:WaitForChild("Never", 2)
			finished = true
		end)
		shim.advance(1.9)
		expect(finished).toBe(false)
		shim.advance(0.2)
		expect(finished).toBe(true)
		expect(result).toBeNil()
		expect(#shim.warnings).toBe(0)
	end)

	it("task.delay/defer/wait run on the virtual clock in order", function()
		local log = {}
		local t0 = os.clock()
		task.delay(2, function() table.insert(log, "delay2") end)
		task.delay(1, function() table.insert(log, "delay1") end)
		task.defer(function() table.insert(log, "defer") end)
		task.spawn(function()
			table.insert(log, "spawn-start")
			local elapsed = task.wait(1.5)
			table.insert(log, "spawn-after-wait")
			expect(elapsed).toBeGreaterThanOrEqual(1.5)
		end)
		expect(log).toEqual({ "spawn-start" })
		shim.advance(0)
		expect(log).toEqual({ "spawn-start", "defer" })
		shim.advance(1)
		expect(log).toEqual({ "spawn-start", "defer", "delay1" })
		expect(os.clock() - t0).toBeCloseTo(1)
		shim.advance(1)
		expect(log).toEqual({ "spawn-start", "defer", "delay1", "spawn-after-wait", "delay2" })
		expect(os.clock() - t0).toBeCloseTo(2)
	end)

	it("task.wait works inside an it() body because the runner drives the clock", function()
		local before = os.clock()
		task.wait(3)
		expect(os.clock() - before).toBeCloseTo(3)
		local signal = shim.Signal.new()
		task.delay(0.5, function() signal:Fire("hello", 2) end)
		local a, b = signal:Wait()
		expect(a).toBe("hello")
		expect(b).toBe(2)
	end)

	it("task.cancel stops a waiting thread and legacy wait/spawn/delay exist", function()
		local ran = false
		local th = task.spawn(function()
			task.wait(1)
			ran = true
		end)
		task.cancel(th)
		shim.advance(2)
		expect(ran).toBe(false)
		local legacy = {}
		spawn(function() table.insert(legacy, "spawn") end)
		delay(0.5, function() table.insert(legacy, "delay") end)
		shim.advance(1)
		expect(legacy).toEqual({ "spawn", "delay" })
	end)

	it("RunService.Heartbeat/Stepped fire every step with dt", function()
		local RunService = game:GetService("RunService")
		local total, steps = 0, 0
		RunService.Heartbeat:Connect(function(dt) total += dt steps += 1 end)
		local stepped = 0
		RunService.Stepped:Connect(function(t, dt) stepped += 1 end)
		shim.advance(1, 0.1)
		expect(steps).toBe(10)
		expect(stepped).toBe(10)
		expect(total).toBeCloseTo(1)
		expect(RunService:IsServer()).toBe(true)
		expect(RunService:IsClient()).toBe(false)
		local rendered = 0
		RunService.RenderStepped:Connect(function() rendered += 1 end)
		shim.step(0.1)
		expect(rendered).toBe(0)
		shim.setContext("client")
		expect(RunService:IsClient()).toBe(true)
		RunService:BindToRenderStep("cam", Enum.RenderPriority.Camera.Value, function() rendered += 10 end)
		shim.step(0.1)
		expect(rendered).toBe(11)
		RunService:UnbindFromRenderStep("cam")
		shim.step(0.1)
		expect(rendered).toBe(12)
	end)

	it("virtual clocks: os.clock, os.time, tick, DateTime", function()
		expect(os.clock()).toBe(shim.clock)
		expect(os.time()).toBe(1700000000)
		expect(tick()).toBeCloseTo(1700000000)
		expect(DateTime.now().UnixTimestamp).toBe(1700000000)
		shim.advance(10)
		expect(os.time()).toBe(1700000010)
		expect(DateTime.now():ToIsoDate()).toBe("2023-11-14T22:13:30Z")
		expect(DateTime.fromUnixTimestamp(0):ToIsoDate()).toBe("1970-01-01T00:00:00Z")
		expect(os.date("!%Y", os.time())).toBe("2023")
	end)

	it("background thread errors are recorded", function()
		shim.quiet = true -- keep the expected error out of the test output
		local ok = pcall(function()
			task.spawn(function() error("boom in thread") end)
		end)
		shim.quiet = false
		expect(ok).toBe(true)
		expect(#shim.threadErrors).toBe(1)
		expect(shim.threadErrors[1]).toContain("boom in thread")
		shim.threadErrors = {}
		shim.threadErrorRecords = {}
	end)
end)

describe("Signals", function()
	it("Connect/Disconnect/Once/Fire/Wait semantics", function()
		local sig = shim.Signal.new("test")
		local calls = {}
		local c1 = sig:Connect(function(x) table.insert(calls, "a" .. x) end)
		sig:Connect(function(x) table.insert(calls, "b" .. x) end)
		sig:Once(function(x) table.insert(calls, "once" .. x) end)
		sig:Fire(1)
		expect(calls).toEqual({ "a1", "b1", "once1" })
		c1:Disconnect()
		expect(c1.Connected).toBe(false)
		sig:Fire(2)
		expect(calls).toEqual({ "a1", "b1", "once1", "b2" })
		sig:DisconnectAll()
		sig:Fire(3)
		expect(#calls).toBe(4)
		local part = Instance.new("Part")
		local touched = part.Touched
		expect(part.Touched).toBe(touched)
		touched:Connect(function(other) table.insert(calls, other) end)
		touched:Fire("hit")
		expect(calls[5]).toBe("hit")
	end)

	it("handlers may yield without blocking the firer", function()
		local sig = shim.Signal.new()
		local done = false
		sig:Connect(function()
			task.wait(1)
			done = true
		end)
		sig:Fire()
		expect(done).toBe(false)
		shim.advance(1)
		expect(done).toBe(true)
	end)
end)

describe("Model, parts and physics-ish helpers", function()
	it("PivotTo moves PrimaryPart and all descendant parts rigidly", function()
		local model = Instance.new("Model", workspace)
		local root = Instance.new("Part", model)
		root.CFrame = CFrame.new(0, 0, 0)
		local wheel = Instance.new("Part", model)
		wheel.CFrame = CFrame.new(2, -1, 0)
		local nested = Instance.new("Folder", model)
		local deep = Instance.new("Part", nested)
		deep.CFrame = CFrame.new(0, 0, 4) * CFrame.Angles(0, 0, 0.5)
		model.PrimaryPart = root
		expect(model:GetPivot()).toEqual(CFrame.new(0, 0, 0))
		local target = CFrame.new(10, 5, 0) * CFrame.Angles(0, math.pi / 2, 0)
		model:PivotTo(target)
		expect(root.CFrame:FuzzyEq(target, 1e-6)).toBe(true)
		expect(wheel.Position).toBeCloseTo(v3(10, 4, -2))
		expect(deep.Position).toBeCloseTo(v3(14, 5, 0))
		local rel = root.CFrame:ToObjectSpace(deep.CFrame)
		expect(rel:FuzzyEq(CFrame.new(0, 0, 4) * CFrame.Angles(0, 0, 0.5), 1e-6)).toBe(true)
		model:MoveTo(v3(0, 0, 0))
		expect(root.Position).toBeCloseTo(v3(0, 0, 0))
		expect(root.CFrame.LookVector).toBeCloseTo(target.LookVector)
		model:SetPrimaryPartCFrame(CFrame.new(1, 1, 1)) -- removes the yaw again: wheel offset back to +X
		expect(wheel.Position).toBeCloseTo(v3(3, 0, 1))
		-- parts pivot too
		wheel:PivotTo(CFrame.new(7, 7, 7))
		expect(wheel:GetPivot().Position).toEqual(v3(7, 7, 7))
	end)

	it("GetBoundingBox / GetExtentsSize cover all parts", function()
		local model = Instance.new("Model")
		local a = Instance.new("Part", model)
		a.Size = v3(2, 2, 2)
		a.CFrame = CFrame.new(0, 1, 0)
		local b = Instance.new("Part", model)
		b.Size = v3(2, 2, 2)
		b.CFrame = CFrame.new(10, 1, 0)
		local cf, size = model:GetBoundingBox()
		expect(cf.Position).toBeCloseTo(v3(5, 1, 0))
		expect(size).toBeCloseTo(v3(12, 2, 2))
		expect(model:GetExtentsSize()).toBeCloseTo(v3(12, 2, 2))
		expect(model:GetPivot().Position).toBeCloseTo(v3(5, 1, 0))
	end)

	it("network ownership and collision groups", function()
		local p = Instance.new("Part", workspace)
		local player = shim.addPlayer("Rider", 5)
		expect(p:CanSetNetworkOwnership()).toBe(true)
		p:SetNetworkOwner(player)
		expect(p:GetNetworkOwner()).toBe(player)
		p:SetNetworkOwner(nil)
		expect(p:GetNetworkOwner()).toBeNil()
		p.Anchored = true
		expect(function() p:SetNetworkOwner(player) end).toThrow("anchored")
		expect(p:CanSetNetworkOwnership()).toBe(false)
		p:ApplyImpulse(v3(1, 0, 0)) -- no-op
		local PhysicsService = game:GetService("PhysicsService")
		PhysicsService:RegisterCollisionGroup("Vehicles")
		PhysicsService:RegisterCollisionGroup("Players")
		expect(PhysicsService:IsCollisionGroupRegistered("Vehicles")).toBe(true)
		expect(PhysicsService:CollisionGroupsAreCollidable("Vehicles", "Players")).toBe(true)
		PhysicsService:CollisionGroupSetCollidable("Vehicles", "Players", false)
		expect(PhysicsService:CollisionGroupsAreCollidable("Players", "Vehicles")).toBe(false)
		expect(PhysicsService:CollisionGroupsAreCollidable("Default", "Vehicles")).toBe(true)
		expect(function() PhysicsService:CollisionGroupSetCollidable("Vehicles", "Nope", false) end).toThrow("not registered")
		PhysicsService:UnregisterCollisionGroup("Vehicles")
		expect(PhysicsService:IsCollisionGroupRegistered("Vehicles")).toBe(false)
	end)

	it("Attachments expose world-space values from their parent part", function()
		local part = Instance.new("Part")
		part.CFrame = CFrame.new(10, 0, 0) * CFrame.Angles(0, math.pi / 2, 0)
		local att = Instance.new("Attachment", part)
		att.Position = v3(1, 0, 0)
		expect(att.CFrame.Position).toEqual(v3(1, 0, 0))
		expect(att.WorldPosition).toBeCloseTo(v3(10, 0, -1))
		expect(att.WorldCFrame.Position).toBeCloseTo(v3(10, 0, -1))
		att.WorldPosition = v3(10, 5, 0)
		expect(att.Position).toBeCloseTo(v3(0, 5, 0))
	end)
end)

describe("Humanoid and seats", function()
	local function makeRig()
		local player = shim.addPlayer("Sitter", 10)
		local character = shim.spawnCharacter(player)
		local humanoid = character.Humanoid
		local seat = Instance.new("VehicleSeat", workspace)
		seat.CFrame = CFrame.new(20, 2, 0)
		return player, character, humanoid, seat
	end

	it("Seat:Sit sets Occupant, SeatPart, creates a SeatWeld and fires the Occupant signal", function()
		local _, character, humanoid, seat = makeRig()
		local occupantChanges = 0
		seat:GetPropertyChangedSignal("Occupant"):Connect(function() occupantChanges += 1 end)
		local seated = {}
		humanoid.Seated:Connect(function(active, part) table.insert(seated, { active, part }) end)
		local states = {}
		humanoid.StateChanged:Connect(function(old, new) table.insert(states, new) end)
		seat:Sit(humanoid)
		expect(seat.Occupant).toBe(humanoid)
		expect(humanoid.SeatPart).toBe(seat)
		expect(humanoid.Sit).toBe(true)
		local weld = seat:FindFirstChild("SeatWeld")
		expect(weld).toBeA("Weld")
		expect(weld.Part0).toBe(seat)
		expect(weld.Part1).toBe(character.HumanoidRootPart)
		expect(occupantChanges).toBe(1)
		expect(humanoid:GetState()).toBe(Enum.HumanoidStateType.Seated)
		expect(states).toEqual({ Enum.HumanoidStateType.Seated })
		expect(seated[1][1]).toBe(true)
		expect(seated[1][2]).toBe(seat)
		expect((character.HumanoidRootPart.Position - seat.Position).Magnitude).toBeLessThan(5)
		expect(function() seat.Occupant = nil end).toThrow("read-only")
	end)

	it("humanoid.Sit = false unseats and destroys the weld", function()
		local _, _, humanoid, seat = makeRig()
		seat:Sit(humanoid)
		local occupantChanges = 0
		seat:GetPropertyChangedSignal("Occupant"):Connect(function() occupantChanges += 1 end)
		humanoid.Sit = false
		expect(seat.Occupant).toBeNil()
		expect(humanoid.SeatPart).toBeNil()
		expect(seat:FindFirstChild("SeatWeld")).toBeNil()
		expect(occupantChanges).toBe(1)
	end)

	it("ChangeState(Jumping) or Jump = true unseats", function()
		local _, _, humanoid, seat = makeRig()
		seat:Sit(humanoid)
		humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
		expect(seat.Occupant).toBeNil()
		expect(humanoid.Jump).toBe(true)
		expect(humanoid:GetState()).toBe(Enum.HumanoidStateType.Jumping)
		seat:Sit(humanoid)
		expect(seat.Occupant).toBe(humanoid)
		humanoid.Jump = true
		expect(seat.Occupant).toBeNil()
	end)

	it("destroying the SeatWeld clears the Occupant", function()
		local _, _, humanoid, seat = makeRig()
		seat:Sit(humanoid)
		seat.SeatWeld:Destroy()
		expect(seat.Occupant).toBeNil()
		expect(humanoid.SeatPart).toBeNil()
		expect(humanoid.Sit).toBe(false)
	end)

	it("a seat accepts a new occupant and a humanoid moves between seats", function()
		local _, _, humanoid, seat = makeRig()
		local seat2 = Instance.new("Seat", workspace)
		seat:Sit(humanoid)
		seat2:Sit(humanoid)
		expect(seat.Occupant).toBeNil()
		expect(seat2.Occupant).toBe(humanoid)
		expect(humanoid.SeatPart).toBe(seat2)
		expect(seat:FindFirstChild("SeatWeld")).toBeNil()
		expect(seat2:FindFirstChild("SeatWeld")).never.toBeNil()
	end)

	it("Humanoid health, Died and RootPart", function()
		local _, character, humanoid, seat = makeRig()
		expect(humanoid.RootPart).toBe(character.HumanoidRootPart)
		expect(humanoid.Parent).toBe(character)
		expect(character.PrimaryPart).toBe(character.HumanoidRootPart)
		expect(character:FindFirstChild("Head")).never.toBeNil()
		expect(character:FindFirstChild("UpperTorso")).never.toBeNil()
		expect(character:FindFirstChild("LowerTorso")).never.toBeNil()
		expect(character.Humanoid:FindFirstChildOfClass("Animator")).never.toBeNil()
		seat:Sit(humanoid)
		local died = 0
		humanoid.Died:Connect(function() died += 1 end)
		humanoid:TakeDamage(50)
		expect(humanoid.Health).toBe(50)
		humanoid.Health = 0
		expect(died).toBe(1)
		expect(humanoid:GetState()).toBe(Enum.HumanoidStateType.Dead)
		expect(seat.Occupant).toBeNil()
		humanoid.Health = -5
		expect(died).toBe(1)
		humanoid.Health = 500
		expect(humanoid.Health).toBe(100)
	end)
end)

